---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';
import { hexToRgb, mixRgb, rgbToHex } from '../lib/color';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });

// Word-by-word reveal matching gsap.com/text's own hero: each word
// scrambles through random characters before settling on the real text,
// each icon scales/fades in - both on the same staggered timeline so the
// whole sentence cascades in as one continuous wave rather than four
// separate per-line ones.
//
// The icons themselves echo that reference's glossy gradient-blob
// language (not literal photos) and are purely decorative - they were a
// real link to each matching project for a while, but that gave a
// visitor a navigational control with no visible affordance until
// hover, and no affordance at all on a touch device (no hover to gate
// it on), while duplicating a job the Selected Works grid right below
// already does with full context (title, description, thumbnail).
// Tinted from the site's own accent so the hero stays inside the
// one-accent discipline the rest of the page keeps; a different tonal
// step per icon (lightest to darkest) adds rhythm without new hues.
type HeroIconKind = 'bars' | 'chat' | 'phone' | 'loop';
interface HeroIconWord {
  type: 'icon';
  icon: HeroIconKind;
  gradientLight: string;
  gradientDark: string;
}
type HeroWord = { type: 'text'; text: string; variant?: 'em' | 'muted' } | HeroIconWord;

const heroAccentRgb = hexToRgb('#6b2737');
const heroIconTones: Record<HeroIconKind, { light: number; dark: number }> = {
  bars: { light: 62, dark: 60 },
  chat: { light: 50, dark: 68 },
  phone: { light: 38, dark: 76 },
  loop: { light: 26, dark: 84 },
};

const heroIcon = (icon: HeroIconKind): HeroIconWord => {
  const tone = heroIconTones[icon];
  return {
    type: 'icon',
    icon,
    gradientLight: rgbToHex(mixRgb(heroAccentRgb, [255, 255, 255], tone.light)),
    gradientDark: rgbToHex(mixRgb(heroAccentRgb, [0, 0, 0], tone.dark)),
  };
};

const heroLineWords: HeroWord[][] = [
  [
    { type: 'text', text: "Hi," },
    { type: 'text', text: "it's" },
    heroIcon('bars'),
    { type: 'text', text: 'Aditya', variant: 'em' },
  ],
  [
    { type: 'text', text: 'an' },
    { type: 'text', text: 'experience' },
    heroIcon('chat'),
    { type: 'text', text: 'designer' },
  ],
  [
    { type: 'text', text: 'with' },
    { type: 'text', text: 'roots' },
    heroIcon('phone'),
    { type: 'text', text: 'in' },
    { type: 'text', text: 'product' },
  ],
  [
    { type: 'text', text: 'and' },
    { type: 'text', text: 'UI/UX' },
    { type: 'text', text: 'who', variant: 'muted' },
    { type: 'text', text: 'builds', variant: 'muted' },
    heroIcon('loop'),
    { type: 'text', text: 'for', variant: 'muted' },
    { type: 'text', text: 'impact.', variant: 'muted' },
  ],
];

let heroWordIndex = 0;
const heroLines = heroLineWords.map((line) =>
  line.map((word) => ({ ...word, delay: 100 + heroWordIndex++ * 60 })),
);
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <defs>
          <filter id="hero-icon-shadow" x="-50%" y="-50%" width="200%" height="200%">
            <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#2a1a14" flood-opacity="0.22" />
          </filter>
        </defs>
      </svg>
      <h1 class="hero__headline">
        {heroLines.map((line) => (
          <span class="hero__line">
            {line.map((word) =>
              word.type === 'icon' ? (
                <span class="hero__word hero__word--icon" style={`animation-delay: ${word.delay}ms`} aria-hidden="true">
                  <svg viewBox="0 0 48 48" class="hero__word-icon">
                    <defs>
                      <linearGradient id={`hero-grad-${word.icon}`} x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color={word.gradientLight} />
                        <stop offset="1" stop-color={word.gradientDark} />
                      </linearGradient>
                    </defs>
                    {word.icon === 'bars' ? (
                      <g filter="url(#hero-icon-shadow)" fill={`url(#hero-grad-${word.icon})`}>
                        <rect x="6" y="24" width="9" height="18" rx="4.5" />
                        <rect x="19.5" y="10" width="9" height="32" rx="4.5" />
                        <rect x="33" y="18" width="9" height="24" rx="4.5" />
                      </g>
                    ) : word.icon === 'chat' ? (
                      <g filter="url(#hero-icon-shadow)" fill={`url(#hero-grad-${word.icon})`}>
                        <rect x="5" y="8" width="38" height="26" rx="13" />
                        <path d="M14 32 L10 42 L21 33 Z" />
                      </g>
                    ) : word.icon === 'phone' ? (
                      <g filter="url(#hero-icon-shadow)">
                        <rect x="13" y="4" width="22" height="40" rx="7" fill={`url(#hero-grad-${word.icon})`} />
                        <rect x="19" y="36" width="10" height="3" rx="1.5" fill="#fff" opacity="0.5" />
                      </g>
                    ) : (
                      <g filter="url(#hero-icon-shadow)">
                        <path
                          d="M24 8 A16 16 0 1 1 10.6 16"
                          fill="none"
                          stroke={`url(#hero-grad-${word.icon})`}
                          stroke-width="7"
                          stroke-linecap="round"
                        />
                        <path d="M8 10 L12 18 L18 12 Z" fill={word.gradientDark} />
                      </g>
                    )}
                  </svg>
                </span>
              ) : (
                <span class="hero__word">
                  {word.variant === 'em' ? (
                    <em class="hero__word-text" style={`animation-delay: ${word.delay}ms`}>{word.text}</em>
                  ) : word.variant === 'muted' ? (
                    <em class="hero__muted-em hero__word-text" style={`animation-delay: ${word.delay}ms`}>{word.text}</em>
                  ) : (
                    <span class="hero__word-text" style={`animation-delay: ${word.delay}ms`}>{word.text}</span>
                  )}
                </span>
              ),
            )}
          </span>
        ))}
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    /* Capped by width (56vw), not just height: on a landscape viewport
       the 100svh term wins and the hero reads as a near-full-viewport
       splash as before. On a tall/portrait one (tablet portrait, a
       narrow laptop window) 100svh alone would blow this row out far
       past the actual text+video content height, leaving a dead gap
       before Selected Works - the 56vw cap keeps the row's height tied
       to its own width instead of the viewport's height. */
    min-height: min(calc(100svh - 150px), 56vw);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: inline-block;
    margin-right: 0.26em;
  }

  /* A slow focus-pull rather than a rise - each word starts slightly
     enlarged and soft, then sharpens and settles into place, like a
     camera finding focus. No vertical motion at all, so it reads as a
     distinctly different gesture from the usual fade-up-on-scroll,
     and a longer duration with a wider per-word stagger (tokens.css's
     --ease-entrance, the same decelerating curve reserved site-wide for
     one-off moments like this) makes the whole sentence settle in
     slowly and deliberately instead of snapping into place. */
  .hero__word-text {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.14);
    animation: hero-word-in 950ms var(--ease-entrance) forwards;
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  /* The one spot the hero borrows the gsap.com/text reference's trick of
     splicing small glossy-gradient shapes into the sentence - purely
     decorative (see the note above the data), so no hover state or
     affordance to imply otherwise. Same focus-pull as the words around
     it, so the whole line reads as one wave rather than two different
     effects running side by side. */
  .hero__word--icon {
    position: relative;
    top: -0.1em;
    vertical-align: middle;
    margin-right: 0.14em;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.14);
    animation: hero-word-in 950ms var(--ease-entrance) forwards;
  }

  /* Tightens the gap on the word right before an icon too (not just the
     icon's own trailing gap above) - an icon slotted between two words
     turns what used to be one gap into two, and reclaiming space on both
     sides is what buys this image enough room to read clearly without
     pushing its line onto a second row. */
  .hero__word:has(+ .hero__word--icon) {
    margin-right: 0.14em;
  }

  .hero__word-icon {
    display: block;
    height: 1.4em;
    width: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word-text,
    .hero__word--icon {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
