---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';
import { hexToRgb, mixRgb, rgbToHex } from '../lib/color';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });

// Word-by-word reveal matching gsap.com/text's own hero: each word
// scrambles through random characters before settling on the real text,
// each icon scales/fades in - both on the same staggered timeline so the
// whole sentence cascades in as one continuous wave rather than four
// separate per-line ones.
//
// The icons themselves echo that reference's glossy gradient-blob
// language (not literal photos) and are purely decorative - they were a
// real link to each matching project for a while, but that gave a
// visitor a navigational control with no visible affordance until
// hover, and no affordance at all on a touch device (no hover to gate
// it on), while duplicating a job the Selected Works grid right below
// already does with full context (title, description, thumbnail).
//
// Simplified flat silhouettes of Aditya's own things (a coffee cup, a
// football, a film reel, a game controller) - personal rather than
// generic UX iconography, redrawn as single-tone shapes so they stay
// legible at this size and inside the one-accent discipline the rest
// of the page keeps. A different tonal step per icon (lightest to
// darkest) adds rhythm without new hues.
type HeroIconKind = 'coffee' | 'football' | 'film' | 'controller';
interface HeroIconWord {
  type: 'icon';
  icon: HeroIconKind;
  gradientLight: string;
  gradientDark: string;
}
type HeroWord = { type: 'text'; text: string; variant?: 'em' | 'muted' } | HeroIconWord;

const heroAccentRgb = hexToRgb('#6b2737');
const heroIconTones: Record<HeroIconKind, { light: number; dark: number }> = {
  coffee: { light: 58, dark: 60 },
  football: { light: 44, dark: 68 },
  film: { light: 32, dark: 76 },
  controller: { light: 22, dark: 84 },
};

const heroIcon = (icon: HeroIconKind): HeroIconWord => {
  const tone = heroIconTones[icon];
  return {
    type: 'icon',
    icon,
    gradientLight: rgbToHex(mixRgb(heroAccentRgb, [255, 255, 255], tone.light)),
    gradientDark: rgbToHex(mixRgb(heroAccentRgb, [0, 0, 0], tone.dark)),
  };
};

const heroLineWords: HeroWord[][] = [
  [
    { type: 'text', text: "Hi," },
    { type: 'text', text: "it's" },
    heroIcon('coffee'),
    { type: 'text', text: 'Aditya', variant: 'em' },
  ],
  [
    { type: 'text', text: 'an' },
    { type: 'text', text: 'experience' },
    heroIcon('football'),
    { type: 'text', text: 'designer' },
  ],
  [
    { type: 'text', text: 'with' },
    { type: 'text', text: 'roots' },
    heroIcon('film'),
    { type: 'text', text: 'in' },
    { type: 'text', text: 'product' },
  ],
  [
    { type: 'text', text: 'and' },
    { type: 'text', text: 'UI/UX' },
    { type: 'text', text: 'who', variant: 'muted' },
    { type: 'text', text: 'builds', variant: 'muted' },
    heroIcon('controller'),
    { type: 'text', text: 'for', variant: 'muted' },
    { type: 'text', text: 'impact.', variant: 'muted' },
  ],
];

let heroWordIndex = 0;
const heroLines = heroLineWords.map((line) =>
  line.map((word) => ({ ...word, delay: 100 + heroWordIndex++ * 60 })),
);
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <defs>
          <filter id="hero-icon-shadow" x="-50%" y="-50%" width="200%" height="200%">
            <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#2a1a14" flood-opacity="0.22" />
          </filter>
        </defs>
      </svg>
      <h1 class="hero__headline">
        {heroLines.map((line) => (
          <span class="hero__line">
            {line.map((word) =>
              word.type === 'icon' ? (
                <span class="hero__word hero__word--icon" style={`animation-delay: ${word.delay}ms`} aria-hidden="true">
                  <svg viewBox="0 0 48 48" class={`hero__word-icon hero__word-icon--${word.icon}`}>
                    <defs>
                      <linearGradient id={`hero-grad-${word.icon}`} x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color={word.gradientLight} />
                        <stop offset="1" stop-color={word.gradientDark} />
                      </linearGradient>
                    </defs>
                    {word.icon === 'coffee' ? (
                      <g filter="url(#hero-icon-shadow)">
                        <rect x="7" y="5" width="34" height="10" rx="5" fill={`url(#hero-grad-${word.icon})`} />
                        <path d="M9 16 H39 L34 39 Q34 42 30 42 H18 Q14 42 14 39 Z" fill={`url(#hero-grad-${word.icon})`} />
                        <rect x="16" y="37" width="16" height="4" rx="2" fill="#fff" opacity="0.4" />
                        <path class="hero__icon-fx hero__icon-fx--steam" d="M19 3 Q17 0 19 -3 M26 3 Q24 0 26 -3" fill="none" stroke={word.gradientDark} stroke-width="2" stroke-linecap="round" />
                      </g>
                    ) : word.icon === 'football' ? (
                      <g filter="url(#hero-icon-shadow)">
                        <circle cx="24" cy="24" r="19" fill={`url(#hero-grad-${word.icon})`} />
                        <g class="hero__icon-fx hero__icon-fx--spin">
                          <path d="M24 14 L31 20 L28 29 L20 29 L17 20 Z" fill={word.gradientDark} opacity="0.7" />
                          <g stroke={word.gradientDark} stroke-width="2" stroke-linecap="round" opacity="0.6" fill="none">
                            <path d="M24 14 Q23 9 22 6" />
                            <path d="M31 20 Q36 17 40 15" />
                            <path d="M28 29 Q31 34 33 38" />
                            <path d="M20 29 Q17 34 15 38" />
                            <path d="M17 20 Q12 17 8 15" />
                          </g>
                        </g>
                      </g>
                    ) : word.icon === 'film' ? (
                      <g filter="url(#hero-icon-shadow)">
                        <rect x="10" y="4" width="28" height="40" rx="4" fill={`url(#hero-grad-${word.icon})`} />
                        <rect x="12.5" y="7" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="12.5" y="14" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="12.5" y="21" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="12.5" y="28" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="12.5" y="35" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="31.5" y="7" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="31.5" y="14" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="31.5" y="21" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="31.5" y="28" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect x="31.5" y="35" width="4" height="4" rx="1" fill="#fff" opacity="0.4" />
                        <rect class="hero__icon-fx hero__icon-fx--frame" x="19" y="9" width="10" height="12" rx="2" fill="#fff" opacity="0.55" />
                        <rect class="hero__icon-fx hero__icon-fx--frame" x="19" y="25" width="10" height="12" rx="2" fill="#fff" opacity="0.55" style="animation-delay: 90ms" />
                      </g>
                    ) : (
                      <g filter="url(#hero-icon-shadow)">
                        <path
                          d="M13 15 H35 Q41 15 42 21 L44 31 Q45 37 39 37 Q35 37 33 32 H15 Q13 37 9 37 Q3 37 4 31 L6 21 Q7 15 13 15 Z"
                          fill={`url(#hero-grad-${word.icon})`}
                        />
                        <path d="M13 22 V28 M10 25 H16" stroke="#fff" stroke-width="2.6" stroke-linecap="round" opacity="0.45" />
                        <circle class="hero__icon-fx hero__icon-fx--btn" cx="32" cy="22" r="2.1" fill="#fff" opacity="0.45" />
                        <circle class="hero__icon-fx hero__icon-fx--btn" cx="37" cy="27" r="2.1" fill="#fff" opacity="0.45" style="animation-delay: 80ms" />
                      </g>
                    )}
                  </svg>
                </span>
              ) : (
                <span class="hero__word">
                  {word.variant === 'em' ? (
                    <em class="hero__word-text" style={`animation-delay: ${word.delay}ms`}>{word.text}</em>
                  ) : word.variant === 'muted' ? (
                    <em class="hero__muted-em hero__word-text" style={`animation-delay: ${word.delay}ms`}>{word.text}</em>
                  ) : (
                    <span class="hero__word-text" style={`animation-delay: ${word.delay}ms`}>{word.text}</span>
                  )}
                </span>
              ),
            )}
          </span>
        ))}
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    /* Capped by width (56vw), not just height: on a landscape viewport
       the 100svh term wins and the hero reads as a near-full-viewport
       splash as before. On a tall/portrait one (tablet portrait, a
       narrow laptop window) 100svh alone would blow this row out far
       past the actual text+video content height, leaving a dead gap
       before Selected Works - the 56vw cap keeps the row's height tied
       to its own width instead of the viewport's height. */
    min-height: min(calc(100svh - 150px), 56vw);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: inline-block;
    margin-right: 0.26em;
  }

  /* A slow focus-pull rather than a rise - each word starts slightly
     enlarged and soft, then sharpens and settles into place, like a
     camera finding focus. No vertical motion at all, so it reads as a
     distinctly different gesture from the usual fade-up-on-scroll,
     and a longer duration with a wider per-word stagger (tokens.css's
     --ease-entrance, the same decelerating curve reserved site-wide for
     one-off moments like this) makes the whole sentence settle in
     slowly and deliberately instead of snapping into place. */
  .hero__word-text {
    display: inline-block;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.14);
    animation: hero-word-in 950ms var(--ease-entrance) forwards;
  }

  @keyframes hero-word-in {
    to {
      opacity: 1;
      filter: blur(0);
      transform: scale(1);
    }
  }

  /* The one spot the hero borrows the gsap.com/text reference's trick of
     splicing small glossy-gradient shapes into the sentence - purely
     decorative (see the note above the data), so no hover state or
     affordance to imply otherwise. Same focus-pull as the words around
     it, so the whole line reads as one wave rather than two different
     effects running side by side. */
  .hero__word--icon {
    position: relative;
    top: -0.1em;
    vertical-align: middle;
    margin-right: 0.14em;
    opacity: 0;
    filter: blur(10px);
    transform: scale(1.14);
    animation: hero-word-in 950ms var(--ease-entrance) forwards;
  }

  /* Tightens the gap on the word right before an icon too (not just the
     icon's own trailing gap above) - an icon slotted between two words
     turns what used to be one gap into two, and reclaiming space on both
     sides is what buys this image enough room to read clearly without
     pushing its line onto a second row. */
  .hero__word:has(+ .hero__word--icon) {
    margin-right: 0.14em;
  }

  .hero__word-icon {
    display: block;
    height: 1.4em;
    width: auto;
    overflow: visible;
  }

  /* A resting tilt per icon, not dead-straight, so the four read as a
     loosely scattered handful of things rather than a row of identical
     boxes - small, distinct angles, no two alike. */
  .hero__word-icon--coffee {
    transform: rotate(-7deg);
  }

  .hero__word-icon--football {
    transform: rotate(9deg);
  }

  .hero__word-icon--film {
    transform: rotate(-5deg);
  }

  .hero__word-icon--controller {
    transform: rotate(6deg);
  }

  /* One themed gesture per icon on hover/focus - a steam wisp, a spin,
     a frame advancing, a button press - but all on the same trigger,
     duration family and easing, so they read as one disciplined set
     rather than four unrelated party tricks. Mouse/trackpad only: a
     touch tap has no hover to answer, so nothing here is the only way
     to notice these are illustrations, just a bonus for lingering. */
  .hero__icon-fx--steam {
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__word--icon:hover .hero__icon-fx--steam,
    .hero__word--icon:focus-visible .hero__icon-fx--steam {
      animation: hero-icon-steam 700ms var(--ease-standard);
    }

    .hero__word--icon:hover .hero__icon-fx--spin,
    .hero__word--icon:focus-visible .hero__icon-fx--spin {
      animation: hero-icon-spin 550ms var(--ease-standard);
      transform-origin: 24px 24px;
    }

    .hero__word--icon:hover .hero__icon-fx--frame,
    .hero__word--icon:focus-visible .hero__icon-fx--frame {
      animation: hero-icon-frame-advance 500ms var(--ease-standard);
    }

    .hero__word--icon:hover .hero__icon-fx--btn,
    .hero__word--icon:focus-visible .hero__icon-fx--btn {
      animation: hero-icon-btn-press 450ms var(--ease-standard);
      transform-origin: center;
    }

    /* A shared compress-then-spring-back layered on top of each icon's
       own gesture above - a quick squash on contact and an overshoot
       past full size on the way back, the same shape a physical button
       or a haptic tap gives, rather than a plain hover scale. Each
       icon's own keyframe keeps its resting tilt (the transform these
       fire on also carries that static rotate) so the bounce doesn't
       momentarily straighten it out. */
    .hero__word--icon:hover .hero__word-icon--coffee,
    .hero__word--icon:focus-visible .hero__word-icon--coffee {
      animation: hero-icon-haptic-coffee 420ms var(--ease-standard);
    }

    .hero__word--icon:hover .hero__word-icon--football,
    .hero__word--icon:focus-visible .hero__word-icon--football {
      animation: hero-icon-haptic-football 420ms var(--ease-standard);
    }

    .hero__word--icon:hover .hero__word-icon--film,
    .hero__word--icon:focus-visible .hero__word-icon--film {
      animation: hero-icon-haptic-film 420ms var(--ease-standard);
    }

    .hero__word--icon:hover .hero__word-icon--controller,
    .hero__word--icon:focus-visible .hero__word-icon--controller {
      animation: hero-icon-haptic-controller 420ms var(--ease-standard);
    }
  }

  @keyframes hero-icon-haptic-coffee {
    0%,
    100% {
      transform: rotate(-7deg) scale(1);
    }
    35% {
      transform: rotate(-7deg) scale(0.86);
    }
    65% {
      transform: rotate(-7deg) scale(1.06);
    }
  }

  @keyframes hero-icon-haptic-football {
    0%,
    100% {
      transform: rotate(9deg) scale(1);
    }
    35% {
      transform: rotate(9deg) scale(0.86);
    }
    65% {
      transform: rotate(9deg) scale(1.06);
    }
  }

  @keyframes hero-icon-haptic-film {
    0%,
    100% {
      transform: rotate(-5deg) scale(1);
    }
    35% {
      transform: rotate(-5deg) scale(0.86);
    }
    65% {
      transform: rotate(-5deg) scale(1.06);
    }
  }

  @keyframes hero-icon-haptic-controller {
    0%,
    100% {
      transform: rotate(6deg) scale(1);
    }
    35% {
      transform: rotate(6deg) scale(0.86);
    }
    65% {
      transform: rotate(6deg) scale(1.06);
    }
  }

  @keyframes hero-icon-steam {
    0% {
      opacity: 0;
      transform: translateY(2px);
    }
    35% {
      opacity: 0.8;
    }
    100% {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes hero-icon-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hero-icon-frame-advance {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(3px);
    }
  }

  @keyframes hero-icon-btn-press {
    0%,
    100% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.65);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word-text,
    .hero__word--icon {
      animation: none;
      opacity: 1;
      filter: none;
      transform: none;
    }

    .hero__word--icon:hover .hero__icon-fx--steam,
    .hero__word--icon:focus-visible .hero__icon-fx--steam,
    .hero__word--icon:hover .hero__icon-fx--spin,
    .hero__word--icon:focus-visible .hero__icon-fx--spin,
    .hero__word--icon:hover .hero__icon-fx--frame,
    .hero__word--icon:focus-visible .hero__icon-fx--frame,
    .hero__word--icon:hover .hero__icon-fx--btn,
    .hero__word--icon:focus-visible .hero__icon-fx--btn,
    .hero__word--icon:hover .hero__word-icon--coffee,
    .hero__word--icon:focus-visible .hero__word-icon--coffee,
    .hero__word--icon:hover .hero__word-icon--football,
    .hero__word--icon:focus-visible .hero__word-icon--football,
    .hero__word--icon:hover .hero__word-icon--film,
    .hero__word--icon:focus-visible .hero__word-icon--film,
    .hero__word--icon:hover .hero__word-icon--controller,
    .hero__word--icon:focus-visible .hero__word-icon--controller {
      animation: none;
    }
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
