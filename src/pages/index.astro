---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';
import { hexToRgb, mixRgb, rgbToHex } from '../lib/color';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });

// Word-by-word reveal matching gsap.com/text's own hero: each word
// scrambles through random characters before settling on the real text,
// each icon scales/fades in - both on the same staggered timeline so the
// whole sentence cascades in as one continuous wave rather than four
// separate per-line ones.
//
// The icons themselves echo that reference's glossy gradient-blob
// language (not literal photos), but instead of staying decorative, each
// one is shaped after a real project and links straight to its case
// study, tinted in that project's own accentColor (so the gradient here
// stays in sync automatically if that color ever changes on the work
// entry itself).
type HeroIconKind = 'bars' | 'chat' | 'phone' | 'loop';
interface HeroIconWord {
  type: 'icon';
  icon: HeroIconKind;
  slug: string;
  title: string;
  gradientLight: string;
  gradientDark: string;
}
type HeroWord = { type: 'text'; text: string; variant?: 'em' | 'muted' } | HeroIconWord;

const findWork = (slug: string) => work.find((entry) => entry.slug === slug)!;

const heroIcon = (icon: HeroIconKind, slug: string): HeroIconWord => {
  const entry = findWork(slug);
  const accent = entry.data.accentColor ?? '#6b2737';
  const rgb = hexToRgb(accent);
  return {
    type: 'icon',
    icon,
    slug,
    title: entry.data.title,
    gradientLight: rgbToHex(mixRgb(rgb, [255, 255, 255], 55)),
    gradientDark: rgbToHex(mixRgb(rgb, [0, 0, 0], 72)),
  };
};

const heroLineWords: HeroWord[][] = [
  [
    { type: 'text', text: "Hi," },
    { type: 'text', text: "it's" },
    heroIcon('bars', 'qurate'),
    { type: 'text', text: 'Aditya', variant: 'em' },
  ],
  [
    { type: 'text', text: 'an' },
    { type: 'text', text: 'experience' },
    heroIcon('chat', 'conversations-before-college'),
    { type: 'text', text: 'designer' },
  ],
  [
    { type: 'text', text: 'with' },
    { type: 'text', text: 'roots' },
    heroIcon('phone', 'neoos'),
    { type: 'text', text: 'in' },
    { type: 'text', text: 'product' },
  ],
  [
    { type: 'text', text: 'and' },
    { type: 'text', text: 'UI/UX' },
    { type: 'text', text: 'who', variant: 'muted' },
    { type: 'text', text: 'builds', variant: 'muted' },
    heroIcon('loop', 'iterate'),
    { type: 'text', text: 'for', variant: 'muted' },
    { type: 'text', text: 'impact.', variant: 'muted' },
  ],
];

let heroWordIndex = 0;
const heroLines = heroLineWords.map((line) =>
  line.map((word) => ({ ...word, delay: 60 + heroWordIndex++ * 35 })),
);
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <defs>
          <filter id="hero-icon-shadow" x="-50%" y="-50%" width="200%" height="200%">
            <feDropShadow dx="0" dy="3" stdDeviation="2.5" flood-color="#2a1a14" flood-opacity="0.22" />
          </filter>
        </defs>
      </svg>
      <h1 class="hero__headline">
        {heroLines.map((line) => (
          <span class="hero__line">
            {line.map((word) =>
              word.type === 'icon' ? (
                <a
                  href={`/work/${word.slug}`}
                  class="hero__word hero__word--icon"
                  aria-label={`View the ${word.title} case study`}
                  style={`animation-delay: ${word.delay}ms`}
                >
                  <svg viewBox="0 0 48 48" class="hero__word-icon" aria-hidden="true">
                    <defs>
                      <linearGradient id={`hero-grad-${word.icon}`} x1="0" y1="0" x2="1" y2="1">
                        <stop offset="0" stop-color={word.gradientLight} />
                        <stop offset="1" stop-color={word.gradientDark} />
                      </linearGradient>
                    </defs>
                    {word.icon === 'bars' ? (
                      <g filter="url(#hero-icon-shadow)" fill={`url(#hero-grad-${word.icon})`}>
                        <rect x="6" y="24" width="9" height="18" rx="4.5" />
                        <rect x="19.5" y="10" width="9" height="32" rx="4.5" />
                        <rect x="33" y="18" width="9" height="24" rx="4.5" />
                      </g>
                    ) : word.icon === 'chat' ? (
                      <g filter="url(#hero-icon-shadow)" fill={`url(#hero-grad-${word.icon})`}>
                        <rect x="5" y="8" width="38" height="26" rx="13" />
                        <path d="M14 32 L10 42 L21 33 Z" />
                      </g>
                    ) : word.icon === 'phone' ? (
                      <g filter="url(#hero-icon-shadow)">
                        <rect x="13" y="4" width="22" height="40" rx="7" fill={`url(#hero-grad-${word.icon})`} />
                        <rect x="19" y="36" width="10" height="3" rx="1.5" fill="#fff" opacity="0.5" />
                      </g>
                    ) : (
                      <g filter="url(#hero-icon-shadow)">
                        <path
                          d="M24 8 A16 16 0 1 1 10.6 16"
                          fill="none"
                          stroke={`url(#hero-grad-${word.icon})`}
                          stroke-width="7"
                          stroke-linecap="round"
                        />
                        <path d="M8 10 L12 18 L18 12 Z" fill={word.gradientDark} />
                      </g>
                    )}
                  </svg>
                </a>
              ) : (
                <span class="hero__word">
                  {word.variant === 'em' ? (
                    <em data-scramble data-delay={word.delay}>{word.text}</em>
                  ) : word.variant === 'muted' ? (
                    <em class="hero__muted-em" data-scramble data-delay={word.delay}>{word.text}</em>
                  ) : (
                    <span data-scramble data-delay={word.delay}>{word.text}</span>
                  )}
                </span>
              ),
            )}
          </span>
        ))}
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    }

    // Matches gsap.com/text's own hero: each word is hidden until its
    // turn, then cycles through random characters for a beat before
    // settling on the real word - a scramble reveal, not a slide/fade.
    // Server-rendered markup already holds the real words (so no-JS and
    // reduced-motion both just show correct, static text); this only
    // hides and scrambles them when motion is allowed.
    if (!prefersReducedMotion) {
      const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
      const randomChar = () => charset[Math.floor(Math.random() * charset.length)];
      const scrambleDuration = 360;
      const frameInterval = 45;

      document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
        const original = el.textContent ?? '';
        const delay = Number(el.dataset.delay ?? 0);
        el.classList.add('is-pending');

        setTimeout(() => {
          el.classList.remove('is-pending');
          let elapsed = 0;
          const tick = () => {
            elapsed += frameInterval;
            if (elapsed >= scrambleDuration) {
              el.textContent = original;
              return;
            }
            el.textContent = original
              .split('')
              .map((ch) => (/\s/.test(ch) ? ch : randomChar()))
              .join('');
            setTimeout(tick, frameInterval);
          };
          tick();
        }, delay);
      });
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    /* Capped by width (56vw), not just height: on a landscape viewport
       the 100svh term wins and the hero reads as a near-full-viewport
       splash as before. On a tall/portrait one (tablet portrait, a
       narrow laptop window) 100svh alone would blow this row out far
       past the actual text+video content height, leaving a dead gap
       before Selected Works - the 56vw cap keeps the row's height tied
       to its own width instead of the viewport's height. */
    min-height: min(calc(100svh - 150px), 56vw);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: inline-block;
    margin-right: 0.26em;
  }

  /* Hidden only once the script has confirmed motion is allowed (added
     as a class, never baked into the default style) - so no-JS and
     reduced-motion visitors always get the plain, correct, already-
     visible sentence underneath. */
  [data-scramble].is-pending {
    opacity: 0;
  }

  /* The one spot the hero borrows the gsap.com/text reference's trick of
     splicing small glossy-gradient shapes into the sentence - except
     each one is a real link to the project it's tinted from (its own
     accentColor), not a decorative glyph. */
  .hero__word--icon {
    vertical-align: middle;
    margin-bottom: -0.1em;
    margin-right: 0.14em;
    opacity: 0;
    transform: scale(0.4);
    animation: hero-icon-in 420ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes hero-icon-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Tightens the gap on the word right before an icon too (not just the
     icon's own trailing gap above) - an icon slotted between two words
     turns what used to be one gap into two, and reclaiming space on both
     sides is what buys this image enough room to read clearly without
     pushing its line onto a second row. */
  .hero__word:has(+ .hero__word--icon) {
    margin-right: 0.14em;
  }

  /* The icon itself (inside the already-entered link) is untouched by
     the entrance animation above - that's purely the link's own
     opacity/scale - so its own transform is free for the hover wiggle
     below without the two fighting over the same property. */
  .hero__word-icon {
    display: block;
    height: 1.4em;
    width: auto;
  }

  /* Each icon is a real link to the project it's tinted from - a small
     hand-nudged wiggle on hover/focus (the same answer-to-the-pointer
     language as the footer's social icons) signals that before anyone
     reads the tiny case-study label, plus the standard focus ring every
     link on the site already gets for free. */
  .hero__word--icon:hover .hero__word-icon,
  .hero__word--icon:focus-visible .hero__word-icon {
    animation: hero-icon-wiggle 420ms var(--ease-standard);
  }

  @keyframes hero-icon-wiggle {
    0% {
      transform: scale(1) rotate(0deg);
    }
    30% {
      transform: scale(1.12) rotate(-7deg);
    }
    65% {
      transform: scale(1.12) rotate(5deg);
    }
    100% {
      transform: scale(1) rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word--icon {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero__word--icon:hover .hero__word-icon,
    .hero__word--icon:focus-visible .hero__word-icon {
      animation: none;
    }
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
