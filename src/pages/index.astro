---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <h1 class="hero__headline">
        Hi, it's <em>Aditya</em><br />
        an experience designer<br />
        with roots in product<br />
        and UI/UX <em class="hero__muted-em">who builds for impact.</em>
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
      <button
        type="button"
        class="hero__video-toggle"
        data-video-toggle
        aria-pressed="false"
        aria-label="Pause animation"
      >
        <svg data-icon-pause width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
          <rect x="0" y="0" width="3" height="12" fill="currentColor" />
          <rect x="7" y="0" width="3" height="12" fill="currentColor" />
        </svg>
        <svg data-icon-play width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
          <path d="M0 0L10 6L0 12V0Z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const toggle = document.querySelector<HTMLButtonElement>('[data-video-toggle]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && toggle) {
      const setPlayingState = (playing: boolean) => {
        toggle.setAttribute('aria-pressed', String(!playing));
        toggle.setAttribute('aria-label', playing ? 'Pause animation' : 'Play animation');
        toggle.classList.toggle('is-paused', !playing);
      };

      if (prefersReducedMotion) {
        video.removeAttribute('autoplay');
        video.pause();
        video.currentTime = 0;
        setPlayingState(false);
      }

      toggle.addEventListener('click', () => {
        if (video.paused) {
          video.play();
          setPlayingState(true);
        } else {
          video.pause();
          setPlayingState(false);
        }
      });
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    min-height: calc(100svh - 150px);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .hero__video-toggle {
    position: absolute;
    bottom: var(--space-4);
    right: var(--space-4);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-bg) 70%, transparent);
    color: var(--color-text);
    cursor: pointer;
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-standard);
  }

  .hero__media:hover .hero__video-toggle,
  .hero__media:focus-within .hero__video-toggle {
    opacity: 1;
  }

  .hero__video-toggle [data-icon-play] {
    display: none;
  }

  .hero__video-toggle.is-paused [data-icon-pause] {
    display: none;
  }

  .hero__video-toggle.is-paused [data-icon-play] {
    display: block;
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
