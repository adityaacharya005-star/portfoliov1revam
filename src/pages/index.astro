---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';
import heroIconWalkmanSrc from '../assets/images/hero-icon-walkman.png';
import heroIconDvdsSrc from '../assets/images/hero-icon-dvds.png';
import heroIconCleatsSrc from '../assets/images/hero-icon-cleats.png';
import heroIconGamesSrc from '../assets/images/hero-icon-games.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });

// A handful of Aditya's own things (not stock icons) standing in as the
// decorative glyphs between words - rendered at 2x the largest on-screen
// size (roughly 90px at the hero's biggest breakpoint) for a crisp retina
// image at a size this small.
const heroIcons = {
  walkman: await getImage({ src: heroIconWalkmanSrc, width: 180 }),
  dvds: await getImage({ src: heroIconDvdsSrc, width: 180 }),
  cleats: await getImage({ src: heroIconCleatsSrc, width: 180 }),
  games: await getImage({ src: heroIconGamesSrc, width: 180 }),
};

// Word-by-word mask reveal (each word, and now each icon, its own
// hidden-overflow slot, sliding up into view on a stagger) rather than the
// old per-line version - same masking technique, just split one level
// finer. Delay is computed once across the whole headline (not reset per
// line) so the cascade reads as one continuous wave rather than four
// separate ones, icons included.
type HeroWord =
  | { type: 'text'; text: string; variant?: 'em' | 'muted' }
  | { type: 'icon'; icon: keyof typeof heroIcons; alt: string };

const heroLineWords: HeroWord[][] = [
  [
    { type: 'text', text: "Hi," },
    { type: 'text', text: "it's" },
    { type: 'icon', icon: 'walkman', alt: '' },
    { type: 'text', text: 'Aditya', variant: 'em' },
  ],
  [
    { type: 'text', text: 'an' },
    { type: 'text', text: 'experience' },
    { type: 'icon', icon: 'dvds', alt: '' },
    { type: 'text', text: 'designer' },
  ],
  [
    { type: 'text', text: 'with' },
    { type: 'text', text: 'roots' },
    { type: 'icon', icon: 'cleats', alt: '' },
    { type: 'text', text: 'in' },
    { type: 'text', text: 'product' },
  ],
  [
    { type: 'text', text: 'and' },
    { type: 'text', text: 'UI/UX' },
    { type: 'text', text: 'who', variant: 'muted' },
    { type: 'text', text: 'builds', variant: 'muted' },
    { type: 'icon', icon: 'games', alt: '' },
    { type: 'text', text: 'for', variant: 'muted' },
    { type: 'text', text: 'impact.', variant: 'muted' },
  ],
];

let heroWordIndex = 0;
const heroLines = heroLineWords.map((line) =>
  line.map((word) => ({ ...word, delay: 80 + heroWordIndex++ * 45 })),
);
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <h1 class="hero__headline">
        {heroLines.map((line) => (
          <span class="hero__line">
            {line.map((word) => (
              <span class:list={['hero__word', { 'hero__word--icon': word.type === 'icon' }]}>
                <span class="hero__word-inner" style={`animation-delay: ${word.delay}ms`}>
                  {word.type === 'icon' ? (
                    <img
                      src={heroIcons[word.icon].src}
                      width={heroIcons[word.icon].attributes.width}
                      height={heroIcons[word.icon].attributes.height}
                      alt={word.alt}
                      aria-hidden="true"
                      class="hero__word-icon"
                    />
                  ) : word.variant === 'em' ? (
                    <em>{word.text}</em>
                  ) : word.variant === 'muted' ? (
                    <em class="hero__muted-em">{word.text}</em>
                  ) : (
                    word.text
                  )}
                </span>
              </span>
            ))}
          </span>
        ))}
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    /* Capped by width (56vw), not just height: on a landscape viewport
       the 100svh term wins and the hero reads as a near-full-viewport
       splash as before. On a tall/portrait one (tablet portrait, a
       narrow laptop window) 100svh alone would blow this row out far
       past the actual text+video content height, leaving a dead gap
       before Selected Works - the 56vw cap keeps the row's height tied
       to its own width instead of the viewport's height. */
    min-height: min(calc(100svh - 150px), 56vw);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__line {
    display: block;
  }

  /* The mask now lives on each word, not the whole line - inline-block so
     words wrap naturally within a line on narrow widths, overflow:hidden
     so each one can slide up out of a hidden slot independently, and the
     same padding/margin trick as before (not the line's problem anymore)
     so a descender (the comma, "g", "p") doesn't get clipped by that
     overflow during the slide. */
  .hero__word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.18em;
    margin-bottom: -0.18em;
    margin-right: 0.26em;
  }

  .hero__word-inner {
    display: inline-block;
    transform: translateY(100%);
    opacity: 0;
    animation: hero-line-in 700ms var(--ease-entrance) forwards;
  }

  /* The one spot the hero borrows the gsap.com/text reference's trick of
     splicing small images into the sentence - except these are Aditya's
     own things (a walkman, game cases, DVDs, football boots), not generic
     stock icons, so it still reads as this person's headline rather than
     a lifted template effect. Same mask-and-slide as every word around
     it, just a taller box since the images need more height than a line
     of text to read clearly at this scale. */
  .hero__word--icon {
    vertical-align: middle;
    margin-bottom: -0.1em;
    margin-right: 0.14em;
  }

  /* Tightens the gap on the word right before an icon too (not just the
     icon's own trailing gap above) - an icon slotted between two words
     turns what used to be one gap into two, and reclaiming space on both
     sides is what buys this image enough room to read clearly without
     pushing its line onto a second row. */
  .hero__word:has(+ .hero__word--icon) {
    margin-right: 0.14em;
  }

  .hero__word-icon {
    display: block;
    height: 1.4em;
    width: auto;
  }

  @keyframes hero-line-in {
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word-inner {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
