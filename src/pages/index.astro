---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });

// Word-by-word mask reveal (each word its own hidden-overflow slot, sliding
// up into view on a stagger) rather than the old per-line version - same
// masking technique, just split one level finer. Delay is computed once
// across the whole headline (not reset per line) so the cascade reads as
// one continuous wave rather than four separate ones.
interface HeroWord {
  text: string;
  variant?: 'em' | 'muted';
}

const heroLineWords: HeroWord[][] = [
  [{ text: "Hi," }, { text: "it's" }, { text: 'Aditya', variant: 'em' }],
  [{ text: 'an' }, { text: 'experience' }, { text: 'designer' }],
  [{ text: 'with' }, { text: 'roots' }, { text: 'in' }, { text: 'product' }],
  [
    { text: 'and' },
    { text: 'UI/UX' },
    { text: 'who', variant: 'muted' },
    { text: 'builds', variant: 'muted' },
    { text: 'for', variant: 'muted' },
    { text: 'impact.', variant: 'muted' },
  ],
];

let heroWordIndex = 0;
const heroLines = heroLineWords.map((line) =>
  line.map((word) => ({ ...word, delay: 60 + heroWordIndex++ * 35 })),
);
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <h1 class="hero__headline">
        {heroLines.map((line) => (
          <span class="hero__line">
            {line.map((word) => (
              <span class="hero__word">
                <span class="hero__word-inner" style={`animation-delay: ${word.delay}ms`}>
                  {word.variant === 'em' ? (
                    <em>{word.text}</em>
                  ) : word.variant === 'muted' ? (
                    <em class="hero__muted-em">{word.text}</em>
                  ) : (
                    word.text
                  )}
                </span>
              </span>
            ))}
          </span>
        ))}
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    /* Capped by width (56vw), not just height: on a landscape viewport
       the 100svh term wins and the hero reads as a near-full-viewport
       splash as before. On a tall/portrait one (tablet portrait, a
       narrow laptop window) 100svh alone would blow this row out far
       past the actual text+video content height, leaving a dead gap
       before Selected Works - the 56vw cap keeps the row's height tied
       to its own width instead of the viewport's height. */
    min-height: min(calc(100svh - 150px), 56vw);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__line {
    display: block;
  }

  /* The mask now lives on each word, not the whole line - inline-block so
     words wrap naturally within a line on narrow widths, overflow:hidden
     so each one can slide up out of a hidden slot independently, and the
     same padding/margin trick as before (not the line's problem anymore)
     so a descender (the comma, "g", "p") doesn't get clipped by that
     overflow during the slide. */
  .hero__word {
    display: inline-block;
    overflow: hidden;
    padding-bottom: 0.18em;
    margin-bottom: -0.18em;
    margin-right: 0.26em;
  }

  /* A pure clip-reveal (no fade) - the word is fully opaque the whole
     time, it's the hidden-overflow box around it that's doing the work,
     so each word reads as sliding up from behind a hard mask edge rather
     than materializing out of a blur. That hard edge is what reads as a
     "masked text reveal" (gsap.com/text's own effect) instead of a soft
     entrance fade; a snappier duration/stagger than the old per-line
     version keeps it feeling mechanical rather than lazy. */
  .hero__word-inner {
    display: inline-block;
    transform: translateY(110%);
    animation: hero-line-in 520ms cubic-bezier(0.65, 0, 0.35, 1) forwards;
  }

  @keyframes hero-line-in {
    to {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word-inner {
      animation: none;
      transform: none;
    }
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
