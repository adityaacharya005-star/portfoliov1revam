---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WorkGrid from '../components/WorkGrid.astro';
import Contact from '../components/Contact.astro';
import heroPosterSrc from '../assets/images/hero-poster.png';
import heroIconWalkmanSrc from '../assets/images/hero-icon-walkman.png';
import heroIconDvdsSrc from '../assets/images/hero-icon-dvds.png';
import heroIconCleatsSrc from '../assets/images/hero-icon-cleats.png';
import heroIconGamesSrc from '../assets/images/hero-icon-games.png';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const heroPoster = await getImage({ src: heroPosterSrc, width: 1280 });

// A handful of Aditya's own things (not stock icons) standing in as the
// decorative glyphs between words.
const heroIcons = {
  walkman: await getImage({ src: heroIconWalkmanSrc, width: 180 }),
  dvds: await getImage({ src: heroIconDvdsSrc, width: 180 }),
  cleats: await getImage({ src: heroIconCleatsSrc, width: 180 }),
  games: await getImage({ src: heroIconGamesSrc, width: 180 }),
};

// Word-by-word reveal matching gsap.com/text's own hero: each word
// scrambles through random characters before settling on the real text,
// each icon scales/fades in - both on the same staggered timeline so the
// whole sentence cascades in as one continuous wave rather than four
// separate per-line ones.
type HeroWord =
  | { type: 'text'; text: string; variant?: 'em' | 'muted' }
  | { type: 'icon'; icon: keyof typeof heroIcons; alt: string };

const heroLineWords: HeroWord[][] = [
  [
    { type: 'text', text: "Hi," },
    { type: 'text', text: "it's" },
    { type: 'icon', icon: 'walkman', alt: '' },
    { type: 'text', text: 'Aditya', variant: 'em' },
  ],
  [
    { type: 'text', text: 'an' },
    { type: 'text', text: 'experience' },
    { type: 'icon', icon: 'dvds', alt: '' },
    { type: 'text', text: 'designer' },
  ],
  [
    { type: 'text', text: 'with' },
    { type: 'text', text: 'roots' },
    { type: 'icon', icon: 'cleats', alt: '' },
    { type: 'text', text: 'in' },
    { type: 'text', text: 'product' },
  ],
  [
    { type: 'text', text: 'and' },
    { type: 'text', text: 'UI/UX' },
    { type: 'text', text: 'who', variant: 'muted' },
    { type: 'text', text: 'builds', variant: 'muted' },
    { type: 'icon', icon: 'games', alt: '' },
    { type: 'text', text: 'for', variant: 'muted' },
    { type: 'text', text: 'impact.', variant: 'muted' },
  ],
];

let heroWordIndex = 0;
const heroLines = heroLineWords.map((line) =>
  line.map((word) => ({ ...word, delay: 60 + heroWordIndex++ * 35 })),
);
---

<Base title="Home">
  <section class="hero wrapper">
    <div class="hero__text">
      <h1 class="hero__headline">
        {heroLines.map((line) => (
          <span class="hero__line">
            {line.map((word) =>
              word.type === 'icon' ? (
                <span class="hero__word hero__word--icon">
                  <img
                    src={heroIcons[word.icon].src}
                    width={heroIcons[word.icon].attributes.width}
                    height={heroIcons[word.icon].attributes.height}
                    alt={word.alt}
                    aria-hidden="true"
                    class="hero__word-icon"
                    style={`animation-delay: ${word.delay}ms`}
                  />
                </span>
              ) : (
                <span class="hero__word">
                  {word.variant === 'em' ? (
                    <em data-scramble data-delay={word.delay}>{word.text}</em>
                  ) : word.variant === 'muted' ? (
                    <em class="hero__muted-em" data-scramble data-delay={word.delay}>{word.text}</em>
                  ) : (
                    <span data-scramble data-delay={word.delay}>{word.text}</span>
                  )}
                </span>
              ),
            )}
          </span>
        ))}
      </h1>
    </div>
    <div class="hero__media">
      <video
        class="hero__video"
        poster={heroPoster.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        disableRemotePlayback
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label="Looping 3D animation of Aditya working at a desk on a laptop"
        data-autoplay-video
      >
        <source src="/videos/hero.webm" type="video/webm" />
        <source src="/videos/hero.mp4" type="video/mp4" />
      </video>
    </div>
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-autoplay-video]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (video && prefersReducedMotion) {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    }

    // Matches gsap.com/text's own hero: each word is hidden until its
    // turn, then cycles through random characters for a beat before
    // settling on the real word - a scramble reveal, not a slide/fade.
    // Server-rendered markup already holds the real words (so no-JS and
    // reduced-motion both just show correct, static text); this only
    // hides and scrambles them when motion is allowed.
    if (!prefersReducedMotion) {
      const charset = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
      const randomChar = () => charset[Math.floor(Math.random() * charset.length)];
      const scrambleDuration = 360;
      const frameInterval = 45;

      document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
        const original = el.textContent ?? '';
        const delay = Number(el.dataset.delay ?? 0);
        el.classList.add('is-pending');

        setTimeout(() => {
          el.classList.remove('is-pending');
          let elapsed = 0;
          const tick = () => {
            elapsed += frameInterval;
            if (elapsed >= scrambleDuration) {
              el.textContent = original;
              return;
            }
            el.textContent = original
              .split('')
              .map((ch) => (/\s/.test(ch) ? ch : randomChar()))
              .join('');
            setTimeout(tick, frameInterval);
          };
          tick();
        }, delay);
      });
    }
  </script>

  <section class="section wrapper works" aria-labelledby="selected-works-heading">
    <div class="works__header">
      <h2 id="selected-works-heading" class="works__heading">Selected Works</h2>
      <p class="works__subheading">A few projects I am proud of.</p>
    </div>
    <WorkGrid entries={work} />
  </section>

  <Contact />
</Base>

<style>
  .hero {
    /* Capped by width (56vw), not just height: on a landscape viewport
       the 100svh term wins and the hero reads as a near-full-viewport
       splash as before. On a tall/portrait one (tablet portrait, a
       narrow laptop window) 100svh alone would blow this row out far
       past the actual text+video content height, leaving a dead gap
       before Selected Works - the 56vw cap keeps the row's height tied
       to its own width instead of the viewport's height. */
    min-height: min(calc(100svh - 150px), 56vw);
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  .hero__text {
    min-width: 0;
  }

  .hero__headline {
    font-size: var(--text-hero);
    line-height: var(--leading-tight);
    font-style: normal;
  }

  .hero__headline em {
    font-style: italic;
    color: var(--color-text);
  }

  .hero__headline .hero__muted-em {
    color: var(--color-muted);
  }

  .hero__line {
    display: block;
  }

  .hero__word {
    display: inline-block;
    margin-right: 0.26em;
  }

  /* Hidden only once the script has confirmed motion is allowed (added
     as a class, never baked into the default style) - so no-JS and
     reduced-motion visitors always get the plain, correct, already-
     visible sentence underneath. */
  [data-scramble].is-pending {
    opacity: 0;
  }

  /* The one spot the hero borrows the gsap.com/text reference's trick of
     splicing small images into the sentence - except these are Aditya's
     own things (a walkman, game cases, DVDs, football boots), not generic
     stock icons. */
  .hero__word--icon {
    vertical-align: middle;
    margin-bottom: -0.1em;
    margin-right: 0.14em;
  }

  /* Tightens the gap on the word right before an icon too (not just the
     icon's own trailing gap above) - an icon slotted between two words
     turns what used to be one gap into two, and reclaiming space on both
     sides is what buys this image enough room to read clearly without
     pushing its line onto a second row. */
  .hero__word:has(+ .hero__word--icon) {
    margin-right: 0.14em;
  }

  /* Icons scale and fade in (not scramble - there's no text to scramble),
     each on the same staggered timeline as the words around it. */
  .hero__word-icon {
    display: block;
    height: 1.4em;
    width: auto;
    opacity: 0;
    transform: scale(0.4);
    animation: hero-icon-in 420ms cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  @keyframes hero-icon-in {
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__word-icon {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }

  .hero__media {
    position: relative;
    background: var(--color-bg);
  }

  .hero__video {
    width: 100%;
    height: auto;
    display: block;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 62% 60% at 50% 50%, black 78%, transparent 100%);
  }

  .works__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: var(--space-7);
  }

  .works__heading {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .works__subheading {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-align: right;
  }

  @media (max-width: 768px) {
    .hero {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .hero__headline {
      white-space: normal;
    }
  }

  @media (max-width: 480px) {
    .hero__headline {
      font-size: 2.25rem;
    }

    .works__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .works__subheading {
      text-align: left;
    }
  }
</style>
