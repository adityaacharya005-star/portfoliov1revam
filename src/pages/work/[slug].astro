---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={data.title} description={data.description}>
  <div class="case-study wrapper">
    <aside class="case-study__sidebar" aria-label="Case study sections">
      <a href="/work" class="case-study__breadcrumb">
        <span aria-hidden="true">&larr;</span> Work <span class="case-study__breadcrumb-sep">/</span>
        <span class="case-study__breadcrumb-title">{data.title}</span>
      </a>
      <nav>
        <ul class="case-study__nav" data-section-nav>
          {sections.map((s) => (
            <li>
              <a href={`#${s.slug}`} data-section-link={s.slug}>
                <span class="case-study__nav-bullet" aria-hidden="true"></span>
                {s.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={`/work/${next.slug}`} class="case-study__next">
        Next <span aria-hidden="true">&rarr;</span>
      </a>
    </aside>

    <article class="case-study__main">
      <div class="case-study__cover">
        <Image src={data.cover} alt={data.coverAlt} class="case-study__cover-image" />
      </div>

      <div class="case-study__intro">
        <div class="case-study__intro-top">
          {data.eyebrow && <p class="case-study__eyebrow">{data.eyebrow}</p>}
          {data.slidesUrl && (
            <a href={data.slidesUrl} class="case-study__slides" target="_blank" rel="noopener noreferrer">
              View slides <span aria-hidden="true">&#8599;</span>
            </a>
          )}
        </div>
        <h1 class="case-study__title">{data.title}</h1>

        <dl class="case-study__meta">
          <div>
            <dt>Timeline</dt>
            <dd>{data.timeline}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          {data.services && (
            <div>
              <dt>Services</dt>
              <dd>{data.services.join(', ')}</dd>
            </div>
          )}
          <div>
            <dt>Tools</dt>
            <dd>{data.tools.join(', ')}</dd>
          </div>
        </dl>
      </div>

      <div class="case-study__body">
        <Content />
      </div>
    </article>
  </div>

  <Contact />
</Base>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.dataset.sectionLink!))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const setActive = (slug: string) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.sectionLink === slug);
      });
    };

    // Picks the last heading whose top has scrolled above the trigger line —
    // i.e. the section currently being read. Plain scroll math rather than
    // IntersectionObserver margins, which create dead zones for short sections.
    const triggerLine = 140;
    let ticking = false;

    const updateActive = () => {
      ticking = false;
      const atBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (atBottom) {
        setActive(sections[sections.length - 1].id);
        return;
      }
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= triggerLine) {
          current = section;
        }
      }
      setActive(current.id);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    updateActive();
  }
</script>

<style>
  .case-study {
    margin-top: var(--space-9);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .case-study__sidebar {
    position: sticky;
    top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-study__breadcrumb {
    display: block;
    font-size: var(--text-small);
    color: var(--color-muted);
    text-decoration: none;
  }

  .case-study__breadcrumb-sep {
    margin: 0 var(--space-1);
  }

  .case-study__breadcrumb-title {
    color: var(--color-text);
  }

  .case-study__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__nav a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-body);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .case-study__nav-bullet {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: transparent;
    transition: background var(--duration-fast) var(--ease-standard);
  }

  .case-study__nav a.is-active {
    color: var(--color-accent);
  }

  .case-study__nav a.is-active .case-study__nav-bullet {
    background: var(--color-accent);
  }

  .case-study__next {
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
  }

  .case-study__cover {
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .case-study__cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study__intro {
    margin-top: var(--space-7);
  }

  .case-study__intro-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .case-study__eyebrow {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-study__slides {
    font-size: var(--text-small);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .case-study__title {
    margin-top: var(--space-3);
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .case-study__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
  }

  .case-study__meta dt {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .case-study__meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-body);
  }

  .case-study__body {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    max-width: 720px;
  }

  .case-study__body :global(h2) {
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
    scroll-margin-top: var(--space-8);
  }

  .case-study__body :global(p) {
    font-size: var(--text-body);
    color: var(--color-text);
  }

  @media (max-width: 1024px) {
    .case-study {
      grid-template-columns: 180px 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .case-study {
      display: block;
    }

    .case-study__sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .case-study__nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .case-study__next {
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .case-study__title {
      font-size: 2rem;
    }

    .case-study__meta {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
