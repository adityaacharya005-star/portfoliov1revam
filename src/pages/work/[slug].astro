---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { squigglePath } from '../../lib/squiggle';
import { darkenUntilContrast } from '../../lib/color';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);

// A case's accentColor is tuned to look good as a border, icon fill or
// large bold number (3:1 is enough there), but several places set it as
// running text at 11-16px (eyebrows, role labels, the "Key behavior"
// tag), which needs 4.5:1. Rather than hand-picking a second color per
// case, darken the same hue until it clears 4.5:1 against the lightest
// surface it appears on, and use that for text only.
const worstBg = [226, 221, 205]; // a shade under --color-card-warm, as a safety margin
const accentColorText = data.accentColor ? darkenUntilContrast(data.accentColor, worstBg, 4.5) : undefined;
---

<Base title={data.title} description={data.description} hideHeaderOnScroll>
  <div
    class="case-study"
    data-icon-style={data.illustrationStyle ?? 'sketch'}
    style={data.accentColor
      ? `--case-accent: ${data.accentColor}; --case-accent-text: ${accentColorText}`
      : undefined}
  >
    <aside class="case-study__sidebar" aria-label="Case study sections">
      <a href="/work" class="case-study__breadcrumb">
        <svg class="nav-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M11 6l-6 6 6 6" /></svg> Work <span class="case-study__breadcrumb-sep">/</span>
        <span class="case-study__breadcrumb-title">{data.title}</span>
        <svg class="case-study__breadcrumb-underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath('breadcrumb-underline')} /></svg>
      </a>
      <nav>
        <ul class="case-study__nav" data-section-nav>
          {sections.map((s) => (
            <li>
              <a href={`#${s.slug}`} data-section-link={s.slug}>
                <span class="case-study__nav-bullet" aria-hidden="true">
                  <svg viewBox="0 0 24 10" fill="none"><path d={squigglePath(s.slug)} /></svg>
                </span>
                <span class="case-study__nav-text">
                  {s.text}
                  <svg class="case-study__nav-underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath(`${s.slug}-underline`)} /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={`/work/${next.slug}`} class="case-study__next">
        Next <svg class="nav-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        <svg class="case-study__next-underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath('next-underline')} /></svg>
      </a>
    </aside>

    <article class="case-study__main">
      <div class="case-study__cover" style={data.coverRatio ? `--cover-ratio-override: ${data.coverRatio}` : undefined}>
        <Image src={data.cover} alt={data.coverAlt} class="case-study__cover-image" />
      </div>

      <div class="case-study__intro">
        <div class="case-study__intro-top">
          {data.eyebrow && <p class="case-study__eyebrow">{data.eyebrow}</p>}
          {data.slidesUrl && (
            <a href={data.slidesUrl} class="case-study__slides" target="_blank" rel="noopener noreferrer">
              View slides <svg class="nav-arrow nav-arrow--diagonal" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17 17 7M9 7h8v8" /></svg>
            </a>
          )}
        </div>
        <h1 class="case-study__title">{data.title}</h1>
        <p class="case-study__subtitle">{data.description}</p>

        <dl class="case-study__meta">
          <div>
            <dt>Timeline</dt>
            <dd>{data.timeline}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          {data.team && (
            <div>
              <dt>Team</dt>
              <dd>{data.team}</dd>
            </div>
          )}
          {data.services && (
            <div>
              <dt>Services</dt>
              <dd>{data.services.join(', ')}</dd>
            </div>
          )}
          {data.tools && data.tools.length > 0 && (
            <div>
              <dt>Tools</dt>
              <dd>{data.tools.join(', ')}</dd>
            </div>
          )}
        </dl>
      </div>

      <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <defs>
          <filter id="sketch-wobble" x="-20%" y="-20%" width="140%" height="140%">
            <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="2" seed="7" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.2" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          <!-- A bolder, chunkier brush-stroke wobble for Qurate's icons:
               wider noise cells and more displacement so a thick stroke
               reads as a confident hand-brushed mark, not a thin wobbly
               line. -->
          <filter id="brush-wobble" x="-25%" y="-25%" width="150%" height="150%">
            <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="2" seed="4" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise" scale="3.5" xChannelSelector="R" yChannelSelector="G" />
          </filter>
          <!-- sketch-wobble-small (the TOC dash/underline filter) now
               lives in Header.astro, since it's rendered on every page
               and the header nav needs it too. -->
        </defs>
      </svg>

      <div class="case-study__body">
        <Content />
      </div>
    </article>
  </div>

  <dialog class="lightbox" data-lightbox>
    <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close enlarged image">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
    <img class="lightbox__image" data-lightbox-image src="" alt="" />
  </dialog>

  <Contact />
</Base>

<script>
  // astro:page-load fires on the initial load and again after every
  // view-transition navigation, so everything below re-runs for each
  // case study visited in a session without needing the script tag
  // itself re-executed (data-astro-rerun forces Astro to inline the
  // script unprocessed, which breaks the TypeScript syntax used
  // throughout this block — see Header.astro for the same note).
  document.addEventListener('astro:page-load', async () => {
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.dataset.sectionLink!))
    .filter((el): el is HTMLElement => el !== null);

  // With view transitions, window/document survive navigation (unlike a
  // real reload). Drop the previous page's scroll listener and observer
  // before wiring up this page's, so they don't keep stacking up across
  // case studies visited in the same session.
  const win = window as unknown as {
    __tocScrollHandler?: () => void;
    __revealObserver?: IntersectionObserver;
  };
  if (win.__tocScrollHandler) {
    window.removeEventListener('scroll', win.__tocScrollHandler);
  }
  win.__revealObserver?.disconnect();

  if (sections.length > 0) {
    const setActive = (slug: string) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.sectionLink === slug);
      });
    };

    // Picks the last heading whose top has scrolled above the trigger line —
    // i.e. the section currently being read. Plain scroll math rather than
    // IntersectionObserver margins, which create dead zones for short sections.
    const triggerLine = 140;
    let ticking = false;

    const updateActive = () => {
      ticking = false;
      const atBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (atBottom) {
        setActive(sections[sections.length - 1].id);
        return;
      }
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= triggerLine) {
          current = section;
        }
      }
      setActive(current.id);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    win.__tocScrollHandler = onScroll;
    updateActive();
  }

  // Scroll-reveal: each direct child of the body content (headings,
  // paragraphs, figures, card grids) fades/lifts in as it enters the
  // viewport. Gated behind reduced-motion and IntersectionObserver
  // support so content is never hidden if either is unavailable.
  const body = document.querySelector('.case-study__body');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (body && !prefersReducedMotion && 'IntersectionObserver' in window) {
    body.setAttribute('data-reveal', '');
    const revealObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12, rootMargin: '0px 0px -60px 0px' },
    );
    Array.from(body.children).forEach((child) => revealObserver.observe(child));
    win.__revealObserver = revealObserver;
  }

  // Write-on: the stat/outcome card icons (the project's own hand-drawn
  // vocabulary, not the functional TOC dash or toggle icons) trace
  // themselves in once as each card scrolls into view, instead of just
  // appearing. Stroke-only shapes animate via stroke-dasharray; a shape
  // that sets its own fill (a solid dot, a filled accent) can't be
  // "drawn" that way since dasharray only affects the stroke, so it
  // fades in instead, timed to land just as the stroke finishes.
  const winIcons = window as unknown as { __iconDrawObserver?: IntersectionObserver };
  winIcons.__iconDrawObserver?.disconnect();

  const drawIcons = document.querySelectorAll<SVGSVGElement>(
    '.stat-card > .card-icon, .outcome-card > .card-icon',
  );

  if (!prefersReducedMotion && 'IntersectionObserver' in window && drawIcons.length > 0) {
    const STROKE_MS = 650;
    const FILL_DELAY_MS = 480;

    drawIcons.forEach((svg) => {
      const shapes = Array.from(svg.querySelectorAll<SVGGeometryElement>('path, circle, rect, line, polyline, polygon'));
      shapes.forEach((shape) => {
        const fill = shape.getAttribute('fill');
        if (fill && fill !== 'none') {
          shape.style.opacity = '0';
          shape.style.transition = `opacity 280ms ${FILL_DELAY_MS}ms var(--ease-standard)`;
        } else {
          const length = shape.getTotalLength();
          shape.style.strokeDasharray = `${length}`;
          shape.style.strokeDashoffset = `${length}`;
          shape.style.transition = `stroke-dashoffset ${STROKE_MS}ms var(--ease-entrance)`;
        }
      });
    });

    const iconDrawObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const svg = entry.target as SVGSVGElement;
          requestAnimationFrame(() => {
            svg.querySelectorAll<SVGGeometryElement>('path, circle, rect, line, polyline, polygon').forEach((shape) => {
              const fill = shape.getAttribute('fill');
              if (fill && fill !== 'none') {
                shape.style.opacity = '1';
              } else {
                shape.style.strokeDashoffset = '0';
              }
            });
          });
          iconDrawObserver.unobserve(svg);
        });
      },
      { threshold: 0.4 },
    );
    drawIcons.forEach((svg) => iconDrawObserver.observe(svg));
    winIcons.__iconDrawObserver = iconDrawObserver;
  } else {
    // Reduced motion (or no IntersectionObserver): make sure nothing is
    // left pre-hidden by a previous view-transition navigation's setup.
    drawIcons.forEach((svg) => {
      svg.querySelectorAll<SVGElement>('path, circle, rect, line, polyline, polygon').forEach((shape) => {
        shape.style.opacity = '';
        shape.style.strokeDasharray = '';
        shape.style.strokeDashoffset = '';
      });
    });
  }

  // Body-content demo videos (not the hero/work-card ones, which handle
  // this themselves): skip autoplay entirely under reduced motion.
  if (prefersReducedMotion) {
    document.querySelectorAll<HTMLVideoElement>('.case-study__body [data-autoplay-video]').forEach((video) => {
      video.removeAttribute('autoplay');
      video.pause();
      video.currentTime = 0;
    });
  }

  // Lightbox: the dense reference diagrams (sketch sheets, IA maps,
  // journey maps) render small in the body column and are genuinely
  // hard to read at that width, especially on mobile. Clicking one
  // opens it full-size in a native <dialog>; phone-screenshot figures
  // (.figure--white) are excluded since those already read fine small.
  const lightbox = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const lightboxImage = document.querySelector<HTMLImageElement>('[data-lightbox-image]');
  const lightboxClose = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
  if (lightbox && lightboxImage && lightboxClose) {
    let trigger: HTMLImageElement | null = null;

    const openLightbox = (img: HTMLImageElement) => {
      trigger = img;
      lightboxImage.src = img.currentSrc || img.src;
      lightboxImage.alt = img.alt;
      lightbox.showModal();
    };

    document
      .querySelectorAll<HTMLImageElement>('.case-study__body figure:not(.figure--white) img')
      .forEach((img) => {
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        if (!img.hasAttribute('aria-label')) {
          img.setAttribute('aria-label', `Enlarge image: ${img.alt}`);
        }
        img.addEventListener('click', () => openLightbox(img));
        img.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            openLightbox(img);
          }
        });
      });

    lightboxClose.addEventListener('click', () => lightbox.close());
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) lightbox.close();
    });
    lightbox.addEventListener('close', () => {
      lightboxImage.src = '';
      trigger?.focus();
    });
  }

  // SETU curriculum booklet viewer, built on StPageFlip (the `page-flip`
  // package) for a realistic page-turn instead of a hand-rolled one.
  const pageflipEl = document.querySelector<HTMLElement>('[data-pageflip]');
  if (pageflipEl) {
    const { PageFlip } = await import('page-flip');

    const totalPages = parseInt(pageflipEl.dataset.totalPages ?? '0', 10);
    const base = pageflipEl.dataset.base ?? '';
    const ext = pageflipEl.dataset.ext ?? 'webp';
    const pageWidth = parseInt(pageflipEl.dataset.pageWidth ?? '600', 10);
    const pageHeight = parseInt(pageflipEl.dataset.pageHeight ?? '848', 10);

    // HTML mode (real <img> elements) instead of loadFromImages' canvas
    // mode: the library's canvas sizing ignores devicePixelRatio, so on
    // any retina display the canvas backing store renders at 1x and gets
    // blurred up to fill its CSS box no matter how sharp the source
    // images are. Real <img> elements scale natively at full resolution.
    const pageEls: HTMLElement[] = [];
    for (let i = 1; i <= totalPages; i++) {
      const pageEl = document.createElement('div');
      pageEl.className = 'pf-page';
      const img = document.createElement('img');
      img.src = `${base}${i}.${ext}`;
      img.alt = `SETU booklet, page ${i} of ${totalPages}`;
      img.loading = i <= 2 ? 'eager' : 'lazy';
      pageEl.appendChild(img);
      pageEls.push(pageEl);
    }

    const counter = document.querySelector('[data-pageflip-counter]');
    const prevBtn = document.querySelector<HTMLButtonElement>('[data-pageflip-prev]');
    const nextBtn = document.querySelector<HTMLButtonElement>('[data-pageflip-next]');

    const pageFlip = new PageFlip(pageflipEl, {
      width: pageWidth,
      height: pageHeight,
      size: 'stretch',
      minWidth: 240,
      maxWidth: 1200,
      minHeight: 340,
      maxHeight: 1697,
      showCover: true,
      maxShadowOpacity: 0.3,
      flippingTime: prefersReducedMotion ? 1 : 650,
      useMouseEvents: true,
    });

    const updateControls = () => {
      const page = pageFlip.getCurrentPageIndex();
      const count = pageFlip.getPageCount();
      const isEdge = page <= 0 || page >= count - 1;
      const isSpread = pageFlip.getOrientation() === 'landscape' && !isEdge;
      const rightMost = isSpread ? Math.min(page + 2, count) : page + 1;
      if (counter) {
        counter.textContent = isSpread
          ? `Pages ${page + 1}–${rightMost} of ${count}`
          : `Page ${rightMost} of ${count}`;
      }
      if (prevBtn) prevBtn.disabled = page <= 0;
      if (nextBtn) nextBtn.disabled = rightMost >= count;
    };

    pageFlip.on('flip', updateControls);
    pageFlip.on('init', updateControls);
    pageFlip.on('changeOrientation', updateControls);
    pageFlip.loadFromHTML(pageEls);

    prevBtn?.addEventListener('click', () => pageFlip.flipPrev());
    nextBtn?.addEventListener('click', () => pageFlip.flipNext());
  }

  // Stakeholder graph (NeoOS): clicking a node highlights the edges
  // touching it and swaps the detail panel to that stakeholder's own
  // text, so the relationship map is explored rather than just read.
  const stakeholderGraph = document.querySelector<HTMLElement>('.stakeholder-graph');
  if (stakeholderGraph) {
    const nodes = stakeholderGraph.querySelectorAll<HTMLButtonElement>('.graph-node');
    const edges = stakeholderGraph.querySelectorAll<SVGElement>('.graph-edge');
    const detailNameText = stakeholderGraph.querySelector('.stakeholder-graph__detail-name-text');
    const detailTier = stakeholderGraph.querySelector('.stakeholder-graph__detail-tier');
    const detailText = stakeholderGraph.querySelector('.stakeholder-graph__detail-text');

    nodes.forEach((node) => {
      node.addEventListener('click', () => {
        const id = node.dataset.id ?? '';

        nodes.forEach((n) => {
          const active = n === node;
          n.classList.toggle('is-active', active);
          n.setAttribute('aria-pressed', String(active));
        });

        edges.forEach((edge) => {
          const pair = edge.dataset.pair?.split(' ') ?? [];
          edge.classList.toggle('is-highlighted', pair.includes(id));
        });

        if (detailNameText) detailNameText.textContent = node.dataset.name ?? '';
        if (detailTier) detailTier.textContent = node.dataset.tier ?? '';
        if (detailText) detailText.textContent = node.dataset.detail ?? '';
      });
    });
  }

  // NeoOS dark-mode toggles: each button flips every screenshot in its
  // own figure between its light and dark export, so a reader compares
  // a whole set of screens at once instead of one image at a time.
  document.querySelectorAll<HTMLButtonElement>('[data-darkmode-toggle]').forEach((toggle) => {
    const figure = toggle.closest('figure');
    if (!figure) return;
    const images = figure.querySelectorAll<HTMLImageElement>('img[data-dark]');

    toggle.addEventListener('click', () => {
      const isDark = toggle.getAttribute('aria-pressed') === 'true';
      const next = !isDark;
      toggle.setAttribute('aria-pressed', String(next));
      images.forEach((img) => {
        const source = next ? img.dataset.dark : img.dataset.light;
        if (source) img.src = source;
      });
    });
  });

  // NeoOS icon-style toggle: swaps the whole icon grid between the 3D
  // default and the flat alternative, the same compare-the-whole-set
  // pattern as the dark-mode toggles above.
  document.querySelectorAll<HTMLButtonElement>('[data-icon-style-toggle]').forEach((toggle) => {
    const showcase = toggle.closest('.icon-showcase');
    if (!showcase) return;
    const images = showcase.querySelectorAll<HTMLImageElement>('img[data-style-flat]');

    toggle.addEventListener('click', () => {
      const isFlat = toggle.getAttribute('aria-pressed') === 'true';
      const next = !isFlat;
      toggle.setAttribute('aria-pressed', String(next));
      images.forEach((img) => {
        const source = next ? img.dataset.styleFlat : img.dataset.styleDefault;
        if (source) img.src = source;
      });
    });
  });
  });
</script>

<style>
  .case-study {
    --case-accent: var(--color-accent);
    --case-accent-text: var(--color-accent);
    max-width: 1320px;
    /* Anchor the left edge to the same position as the header's
       .wrapper (max-width 1200, centered) and only extend further
       right, so the sidebar always lines up under the avatar/nav
       instead of the two containers centering independently. */
    margin-left: max(calc((100vw - var(--layout-max-width)) / 2), 0px);
    margin-right: auto;
    margin-top: var(--space-9);
    padding-inline: var(--layout-padding);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .case-study__sidebar {
    position: sticky;
    top: calc(90px + var(--space-5)); /* clears the sticky header's own height */
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-study__breadcrumb {
    position: relative;
    display: inline-block;
    font-size: var(--text-small);
    color: var(--color-muted);
    text-decoration: none;
    padding-bottom: 2px;
  }

  /* The hand-drawn squiggle, same as the TOC dash's underline and the
     work-card title underline — this was the last plain straight
     ::after line left on the page besides .case-study__next below. */
  .case-study__breadcrumb-underline {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 7px;
    overflow: visible;
    pointer-events: none;
  }

  .case-study__breadcrumb-underline path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0;
    transform: scaleX(0.9);
    transform-origin: left center;
    transition: opacity var(--duration-fast) var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .case-study__breadcrumb:hover .case-study__breadcrumb-underline path,
  .case-study__breadcrumb:focus-visible .case-study__breadcrumb-underline path {
    opacity: 0.85;
    transform: scaleX(1);
  }

  .case-study__breadcrumb-sep {
    margin: 0 var(--space-1);
  }

  .nav-arrow {
    width: 13px;
    height: 13px;
    vertical-align: -2px;
    flex-shrink: 0;
  }

  .nav-arrow--diagonal {
    vertical-align: -1px;
  }

  /* Matches the work-card arrow: a perfectly clean chevron next to a
     wobbly hand-drawn underline would be the same mismatch we fixed
     there, now that this link's underline is hand-drawn too. */
  .case-study__breadcrumb .nav-arrow path,
  .case-study__next .nav-arrow path {
    filter: url(#sketch-wobble-small);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study__breadcrumb-underline path {
      transition: none;
    }
  }

  .case-study__breadcrumb-title {
    color: var(--color-text);
  }

  .case-study__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__nav a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-micro);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 200ms var(--ease-standard);
  }

  .case-study__nav a:focus-visible {
    outline: none;
  }

  .case-study__nav-bullet {
    display: flex;
    align-items: center;
    width: 18px;
    height: 10px;
    flex-shrink: 0;
  }

  .case-study__nav-bullet svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* A short hand-inked dash, not a dot: a gently wavy stroke (baked
     into the path itself, not just the filter, and seeded per section
     so no two dashes trace the exact same wave) run through the same
     sketch-wobble displacement as the case's own card-icon strokes, so
     every dash in the list reads as hand-drawn at rest, not just the
     active one. */
  .case-study__nav-bullet path {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.75;
    filter: url(#sketch-wobble-small);
    transform-origin: left center;
    transition: stroke 200ms var(--ease-standard),
      stroke-width 200ms var(--ease-standard),
      opacity 200ms var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .case-study[data-icon-style='polished'] .case-study__nav-bullet path {
    filter: none;
  }

  /* A softer, tinted preview, not the full accent: hovering a
     different item while another stays active (common while scanning
     the list) used to color both dashes the same strong accent, which
     made "where you are" and "what your mouse is over" briefly
     indistinguishable. This is deliberately muted and grows less, so
     the active item's dash below stays the one unambiguously bold
     mark even when a neighbor is hovered at the same time. */
  .case-study__nav a:hover .case-study__nav-bullet path,
  .case-study__nav a:focus-visible .case-study__nav-bullet path {
    stroke: color-mix(in srgb, var(--case-accent) 55%, var(--color-muted));
    stroke-width: 2.2;
    opacity: 0.9;
    transform: scaleX(1.08);
  }

  .case-study__nav-text {
    position: relative;
    padding-bottom: 6px;
  }

  /* A second hand-drawn squiggle, this time doing the job a straight
     underline normally would: it only appears on hover/focus, and
     being the same loose-ink stroke as the dash (not a ruled line)
     means the two no longer fight each other the way a wobbly dash
     and a crisp straight underline did before. Replaces the old
     rectangular focus outline too — this wavy underline alone is the
     focus indicator for keyboard users, since it's exactly as visible
     as it is for a mouse hover. */
  .case-study__nav-underline {
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 7px;
    overflow: visible;
    pointer-events: none;
  }

  .case-study__nav-underline path {
    fill: none;
    stroke: var(--case-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0;
    transform: scaleX(0.9);
    transform-origin: left center;
    transition: opacity 200ms var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .case-study[data-icon-style='polished'] .case-study__nav-underline path {
    filter: none;
  }

  .case-study__nav a:hover .case-study__nav-underline path,
  .case-study__nav a:focus-visible .case-study__nav-underline path {
    opacity: 0.85;
    transform: scaleX(1);
  }

  .case-study__nav a.is-active {
    color: var(--case-accent);
    font-weight: 600;
  }

  .case-study__nav a.is-active .case-study__nav-bullet path {
    stroke: var(--case-accent);
    stroke-width: 3;
    opacity: 1;
    transform: scaleX(1.3);
  }

  .case-study[data-icon-style='polished'] .case-study__nav a.is-active .case-study__nav-bullet path {
    stroke-width: 3.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study__nav-bullet path,
    .case-study__nav-underline path {
      transition: none;
    }
  }

  .case-study__next {
    position: relative;
    display: inline-block;
    font-size: var(--text-micro);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
    text-decoration: none;
    padding-bottom: 2px;
  }

  .case-study__next-underline {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 7px;
    overflow: visible;
    pointer-events: none;
  }

  .case-study__next-underline path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0;
    transform: scaleX(0.9);
    transform-origin: left center;
    transition: opacity var(--duration-fast) var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .case-study__next:hover .case-study__next-underline path,
  .case-study__next:focus-visible .case-study__next-underline path {
    opacity: 0.85;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study__next-underline path {
      transition: none;
    }
  }

  .case-study__cover {
    /* Defaults to the homepage card's own ratio (Qurate's hero was
       shot to match it); a case study whose cover needs a different
       crop sets coverRatio in its frontmatter to override per page,
       rather than changing this sitewide. */
    aspect-ratio: var(--cover-ratio-override, var(--card-aspect-ratio));
    overflow: hidden;
    background: var(--color-placeholder);
    animation: case-fade-up 700ms var(--ease-entrance) both;
  }

  .case-study__cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study__intro {
    margin-top: var(--space-7);
    animation: case-fade-up 700ms var(--ease-entrance) both;
    animation-delay: 120ms;
  }

  @keyframes case-fade-up {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-study__cover,
    .case-study__intro {
      animation: none;
    }
  }

  .case-study__intro-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .case-study__eyebrow {
    margin: 0;
    font-size: var(--text-label);
    font-weight: 500;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .case-study__slides {
    font-size: var(--text-label);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .case-study__title {
    margin-top: var(--space-3);
    font-size: 2.25rem;
    line-height: 1.15;
  }

  .case-study__subtitle {
    margin-top: var(--space-3);
    max-width: 640px;
    font-size: var(--text-small);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }

  .case-study__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
  }

  .case-study__meta dt {
    font-size: var(--text-micro);
    font-weight: 500;
    color: var(--color-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .case-study__meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-caption);
    color: var(--color-muted);
    line-height: var(--leading-normal);
  }

  .case-study__body {
    margin-top: var(--space-8);
  }

  /* Scroll-reveal: direct children fade/lift in as they enter the
     viewport (JS adds data-reveal + is-visible; see script above). */
  .case-study__body[data-reveal] > :global(*) {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 700ms var(--ease-entrance), transform 700ms var(--ease-entrance);
  }

  .case-study__body[data-reveal] > :global(*.is-visible) {
    opacity: 1;
    transform: translateY(0);
  }

  /* Rhythm: tight between a heading and what follows it right away,
     loose before the next heading/section, medium between consecutive
     paragraphs — so sections scan as distinct chunks instead of a
     uniform wall of text. */
  .case-study__body > :global(* + *) {
    margin-top: var(--space-9);
  }

  /* A section's heading is now a quiet label rather than a big
     display heading, so it no longer visually announces "new section"
     on its own — the whitespace ahead of it has to do that work
     instead, wider than the rhythm between ordinary elements. */
  .case-study__body > :global(* + h2) {
    margin-top: 7rem;
  }

  .case-study__body > :global(h2 + p) {
    margin-top: var(--space-5);
  }

  /* A grid/figure right after a heading (no lead paragraph in between)
     needs more breathing room than text does — tight works for prose
     continuing the heading's thought, not for a card grid or image. */
  .case-study__body > :global(h2 + ul),
  .case-study__body > :global(h2 + figure) {
    margin-top: var(--space-7);
  }

  .case-study__body > :global(p + p) {
    margin-top: var(--space-5);
  }

  /* A takeaway-list reads as the paragraph finishing its own thought
     ("three decisions:" → the three decisions), not a separate
     exhibit like a stat grid — tight, the same as two paragraphs. */
  .case-study__body > :global(p + .takeaway-list) {
    margin-top: var(--space-5);
  }

  .case-study__body :global(h2) {
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: 600;
    line-height: 1.4;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text);
    scroll-margin-top: var(--space-8);
    text-wrap: balance;
  }

  .case-study__body :global(p) {
    max-width: 720px;
    font-size: var(--text-small);
    line-height: 1.7;
    text-wrap: pretty;
    color: var(--color-muted);
  }

  .case-study__body :global(p strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Diagrams / UI screenshots embedded in the body: shown at natural
     aspect ratio (never cropped), placeholder bg while loading. */
  .case-study__body :global(img),
  .case-study__body :global(video) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-placeholder);
  }

  /* A hairline edge for flat diagrams/screenshots sitting directly on
     the card background, where there's otherwise no line between the
     image and its surroundings. Skipped on .figure--white (phone
     screenshots already get a drop-shadow, and a box-shadow ring would
     hug their transparent corner padding instead of the phone itself). */
  .case-study__body :global(figure:not(.figure--white) img) {
    box-shadow: 0 0 0 1px rgba(17, 17, 17, 0.1);
    /* These are reference diagrams a reader may want to study closer
       (sketch sheets, IA maps, journey maps), not decorative — clicking
       opens the lightbox below, so the cursor and a slightly firmer
       edge on hover are the only affordance needed. */
    cursor: zoom-in;
    transition: box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(figure:not(.figure--white) img:hover) {
    box-shadow: 0 0 0 1px rgba(17, 17, 17, 0.22);
  }

  .case-study__body :global(figure:not(.figure--white) img:focus-visible) {
    outline: 2px solid var(--case-accent);
    outline-offset: 3px;
  }

  .lightbox {
    /* No position override: a native <dialog> already defaults to
       position: fixed with auto margins, which is what centers it in
       the viewport regardless of scroll position. Overriding that to
       relative (an earlier version of this rule) made it render inline
       in the document instead of as a centered overlay. fixed is still
       a valid positioning context for the absolutely-positioned close
       button below. */
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 1400px);
    max-height: 92vh;
    overscroll-behavior: contain;
  }

  .lightbox::backdrop {
    background: rgba(17, 17, 17, 0.72);
  }

  .lightbox__image {
    display: block;
    max-width: 100%;
    max-height: 92vh;
    border-radius: 12px;
    box-shadow: 0 24px 64px rgba(17, 17, 17, 0.35);
  }

  .lightbox__close {
    /* Fixed to the viewport, not absolute within the dialog: the image
       behind it can be light or dark edge to edge (these are diagrams,
       not photos with a predictable dark vignette), so the button needs
       to sit over the backdrop, where contrast is always the same,
       rather than over the image itself. */
    position: fixed;
    top: 20px;
    right: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: none;
    background: rgba(17, 17, 17, 0.55);
    color: #fff;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .lightbox__close svg {
    width: 18px;
    height: 18px;
  }

  .lightbox__close:hover {
    background: rgba(17, 17, 17, 0.75);
  }

  .lightbox__close:active {
    transform: scale(0.96);
  }

  /* Framed like a card rather than bleeding edge-to-edge: padded,
     tinted background behind the screenshot/diagram. */
  .case-study__body :global(figure) {
    margin-inline: 0;
    margin-bottom: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-7);
    /* A light tint of this case's own accent instead of one neutral
       warm tone reused on every project, so the frame around every
       diagram/screenshot carries a bit of each case's own color. */
    background: color-mix(in srgb, var(--case-accent) 12%, var(--color-bg));
  }

  .case-study__body :global(figcaption) {
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    max-width: 720px;
  }

  /* A single centered phone screenshot reads better with its caption
     centered under it too, instead of the caption starting flush left
     while the screen it describes sits in the middle of the figure. */
  .case-study__body :global(.figure-img--phone + figcaption) {
    text-align: center;
    margin-inline: auto;
    max-width: 420px;
  }

  /* The one screen that solves the problem the research opened with
     gets a visible marker, instead of the same even weight as every
     other screenshot. */
  .case-study__body :global(.figure--feature) {
    box-shadow: inset 0 0 0 2px var(--case-accent);
  }

  /* Same idea, different mark: a top accent bar matching this
     project's own left-bar quote treatment, instead of reusing
     Qurate's full box-outline for the equivalent callout. */
  .case-study__body :global(.figure--core) {
    border-top: 4px solid var(--case-accent);
  }

  /* A single phone screen, left at natural size instead of
     stretched to fill the whole column like a desktop screenshot. */
  .case-study__body :global(.figure-img--phone) {
    /* width: auto + max-width here left the browser unable to resolve
       a definite width for a lazy, not-yet-loaded image with only an
       aspect-ratio (from its width/height attributes) to go on inside
       a flex column, computing 0x0 until the image actually loaded and
       supplied its own intrinsic size — a real layout jump as it came
       into view. min() gives a definite width up front, so the
       aspect-ratio can size the box correctly before the image loads. */
    width: min(260px, 100%);
    margin-inline: auto;
    background: transparent;
  }

  /* App screenshots read cleaner on plain white than the warm tan
     frame used for diagrams/photos, closer to how the screens
     actually look standalone. */
  .case-study__body :global(.figure--white) {
    background: #fff;
  }

  .case-study__body :global(.figure--white img) {
    background: transparent;
    /* drop-shadow, not box-shadow: these screenshots carry real alpha
       transparency around their rounded phone corners, so a box-shadow
       would draw a rectangle around that invisible padding instead of
       hugging the phone itself. Needed because a white (or near-white)
       screen on this figure's white ground otherwise has no visible
       edge at all. */
    filter: drop-shadow(0 10px 24px rgba(17, 17, 17, 0.12))
      drop-shadow(0 2px 6px rgba(17, 17, 17, 0.08));
  }

  /* No padding frame at all: for a diagram that's already a finished,
     self-contained image (its own white ground, its own card
     boxes) rather than a screenshot that needs a tinted mat around it. */
  .case-study__body :global(.figure--flush) {
    padding: 0;
    background: #fff;
  }

  /* Two process artifacts side by side instead of each one stacked
     full-width: a sketch sheet and a wireframe board are reference
     material, not the final work, so they don't need hero-sized
     real estate. */
  .case-study__body :global(.figure-row) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
  }

  .case-study__body :global(.figure-row) :global(figure) {
    height: 100%;
  }

  /* A short scannable list instead of one dense paragraph: each
     takeaway is a bold lead-in plus a half-sentence, not a full
     sentence of connective tissue — easier to skim down than read
     across. */
  .case-study__body :global(.takeaway-list) {
    margin-bottom: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__body :global(.takeaway-list) :global(li) {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-2);
    padding-left: var(--space-5);
    position: relative;
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--color-muted);
  }

  .case-study__body :global(.takeaway-list) :global(li::before) {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--case-accent);
  }

  .case-study__body :global(.takeaway-list) :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  /* The curriculum booklet viewer, powered by the StPageFlip library
     (package: page-flip) in its HTML mode — real <img> elements it
     flips with CSS 3D transforms, not canvas mode, whose canvas sizing
     ignores devicePixelRatio and blurs on retina regardless of source
     image resolution. This just sizes the container and styles our
     controls; the four .stf__* classes below are the library's own
     required base styles for HTML mode (normally shipped as a separate
     stPageFlip.css we don't otherwise load). */
  .case-study__body :global(.pageflip) {
    width: 100%;
    margin-inline: auto;
    filter: drop-shadow(0 2px 4px rgba(17, 17, 17, 0.08)) drop-shadow(0 24px 48px rgba(17, 17, 17, 0.12));
  }

  .case-study__body :global(.stf__parent) {
    position: relative;
    display: block;
    box-sizing: border-box;
  }

  .case-study__body :global(.stf__wrapper) {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }

  .case-study__body :global(.stf__block) {
    position: absolute;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    perspective: 2000px;
  }

  .case-study__body :global(.stf__item) {
    display: none;
    position: absolute;
    transform-style: preserve-3d;
  }

  .case-study__body :global(.stf__outerShadow),
  .case-study__body :global(.stf__innerShadow),
  .case-study__body :global(.stf__hardShadow),
  .case-study__body :global(.stf__hardInnerShadow) {
    position: absolute;
    left: 0;
    top: 0;
  }

  .case-study__body :global(.pf-page) {
    background: #fff;
    overflow: hidden;
  }

  .case-study__body :global(.pf-page img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    background: transparent;
  }

  .case-study__body :global(.pageflip__controls) {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    margin-top: var(--space-5);
  }

  .case-study__body :global(.pageflip__btn) {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1.125rem;
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.pageflip__btn:hover:not(:disabled)) {
    background: var(--color-card-warm);
  }

  .case-study__body :global(.pageflip__btn:active:not(:disabled)) {
    transform: scale(0.96);
  }

  .case-study__body :global(.pageflip__btn:disabled) {
    opacity: 0.35;
    cursor: default;
  }

  .case-study__body :global(.pageflip__counter) {
    font-size: var(--text-caption);
    color: var(--color-muted);
    min-width: 90px;
    text-align: center;
    max-width: none;
    margin: 0;
  }

  /* Several phone screens shown as their own cards with their own
     caption, instead of one flattened composite image with a single
     caption underneath, so every screen reads at the same size. */
  .case-study__body :global(.screen-grid) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--space-6);
    row-gap: var(--space-8);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.screen-item) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
  }

  .case-study__body :global(.screen-item img) {
    /* Same fix as .figure-img--phone: width: auto + max-width left the
       browser unable to resolve a definite width for a lazy,
       not-yet-loaded image from its aspect-ratio alone inside a flex
       column, so it rendered 0x0 until the image loaded, then jumped
       to full size — a real, visible layout shift as a reader scrolled
       past each screen-grid figure. min() gives a definite width up
       front so the aspect-ratio can size it correctly immediately. */
    width: min(220px, 100%);
    background: transparent;
  }

  /* A callout tied to the screenshot instead of a paragraph explaining
     a spatial decision in words: a dashed line marks the boundary on
     the image itself, and the two zone names sit just outside it with
     a directional arrow, rather than overlaid on top of screen
     content that varies in height between variants. */
  .case-study__body :global(.screen-annotate) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    /* align-items: center means this flex child shrink-wraps instead
       of stretching to .screen-item's width, so it has no definite
       width of its own — and neither does .screen-annotate__frame
       below it. That left the image inside unable to resolve its
       `min(220px, 100%)` width (100% of an indefinite ancestor), so it
       rendered 0x0 until loaded. width: 100% gives this (and the frame
       below it) a definite width to anchor that percentage against. */
    width: 100%;
  }

  .case-study__body :global(.screen-annotate__tag) {
    font-size: 11px;
    font-weight: 700;
    color: var(--case-accent-text);
    margin: 0;
  }

  .case-study__body :global(.screen-annotate__frame) {
    position: relative;
    width: 100%;
  }

  .case-study__body :global(.screen-annotate__line) {
    position: absolute;
    left: 6%;
    right: 6%;
    border-top: 2px dashed rgba(255, 255, 255, 0.9);
    filter: drop-shadow(0 1px 2px rgba(17, 17, 17, 0.4));
  }

  .case-study__body :global(.screen-caption) {
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    text-align: left;
    width: 220px;
    max-width: 100%;
    margin: 0;
  }

  /* One card per library zone, each tinted and topped in that
     zone's own wayfinding color instead of the project accent, so
     the grid reads the same color language as the floor plan. */
  .case-study__body :global(.zone-grid) {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.zone-card) {
    padding: var(--space-5);
    background: color-mix(in srgb, var(--zone-color) 12%, var(--color-bg));
    border-top: 4px solid var(--zone-color);
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.zone-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(17, 17, 17, 0.1);
  }

  .case-study__body :global(.zone-icon) {
    display: block;
    width: 56px;
    height: 56px;
    margin-bottom: var(--space-3);
    color: var(--zone-color);
    filter: url(#sketch-wobble);
  }

  .case-study__body :global(.zone-label) {
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--zone-color);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 var(--space-2);
  }

  .case-study__body :global(.zone-card h3) {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }

  .case-study__body :global(.zone-card p) {
    font-size: var(--text-caption);
    color: var(--color-muted);
    max-width: none;
    margin: 0;
  }

  .case-study__body :global(.figure-eyebrow) {
    margin: 0;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--case-accent-text);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* Pairs the eyebrow label with the dark-mode toggle on the same
     row, instead of the toggle pushing onto its own line. */
  .case-study__body :global(.figure-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .case-study__body :global(.darkmode-toggle) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 40px;
    font: inherit;
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--case-accent-text);
    background: color-mix(in srgb, var(--case-accent) 12%, transparent);
    border: none;
    border-radius: 999px;
    padding: var(--space-2) var(--space-4);
    cursor: pointer;
    transition: background var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.darkmode-toggle:hover) {
    background: color-mix(in srgb, var(--case-accent) 20%, transparent);
  }

  .case-study__body :global(.darkmode-toggle:active) {
    transform: scale(0.96);
  }

  .case-study__body :global(.darkmode-toggle__icon) {
    width: 14px;
    height: 14px;
  }

  .case-study__body :global(.darkmode-toggle[aria-pressed="true"]) {
    color: #fff;
    background: #282828;
  }

  /* Stakeholder quotes: a flat pull-quote treatment (left accent rule,
     page background, no corner blob) so this reads as a distinct kind
     of card from the stat/outcome/persona family, not a reskin of it. */
  /* Subgrid so "Key behavior" (and everything below it) lands on the
     same row across all three cards, regardless of how long any one
     quote runs — a plain flex column per card left the pill floating
     at a different height on every card. */
  .case-study__body :global(.quote-grid) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto auto auto auto;
    column-gap: var(--space-5);
    row-gap: 0;
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.quote-card) {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 5;
    row-gap: var(--space-4);
    padding: var(--space-6);
    background: var(--color-bg);
    border-left: 3px solid var(--case-accent);
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.quote-icon) {
    display: block;
    align-self: start;
    width: 64px;
    height: 64px;
    color: var(--color-text);
    filter: url(#sketch-wobble);
  }

  .case-study__body :global(.quote-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(17, 17, 17, 0.08);
  }

  .case-study__body :global(.quote-label) {
    align-self: start;
    font-size: var(--text-label);
    font-weight: 600;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0;
  }

  .case-study__body :global(.quote-text) {
    align-self: start;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-quote);
    line-height: 1.35;
    color: var(--color-text);
    max-width: none;
    margin: 0;
  }

  .case-study__body :global(.quote-behavior-tag) {
    align-self: start;
    justify-self: start;
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--case-accent-text);
    background: color-mix(in srgb, var(--case-accent) 12%, transparent);
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
  }

  .case-study__body :global(.quote-behavior) {
    align-self: start;
    font-size: var(--text-caption);
    color: var(--color-muted);
    max-width: none;
    margin: 0;
  }

  .case-study__body :global(.field-validation-row) {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-7);
  }

  .case-study__body > :global(h2 + .field-validation-row) {
    margin-top: var(--space-4);
  }

  .case-study__body :global(.field-validation-row > p) {
    margin: 0;
  }

  /* A real, named person's testimonial: her photo, not a generic
     quote block, so field validation reads as a specific person
     standing behind this, not an anonymous pull-quote. */
  .case-study__body :global(.testimonial-card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 440px;
    padding: var(--space-8) var(--space-7);
    background: color-mix(in srgb, var(--case-accent) 8%, var(--color-bg));
    border-radius: 18px;
    text-align: center;
  }

  .case-study__body :global(.testimonial-photo) {
    width: 128px;
    height: 128px;
    border-radius: 50%;
    object-fit: cover;
    background: transparent;
    margin-bottom: var(--space-6);
  }

  .case-study__body :global(.testimonial-name) {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 700;
    line-height: var(--leading-tight);
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .case-study__body :global(.testimonial-role) {
    font-size: var(--text-label);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--case-accent-text);
    max-width: none;
    margin: 0 0 var(--space-5);
  }

  .case-study__body :global(.testimonial-quote) {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--text-small);
    line-height: var(--leading-normal);
    color: var(--color-text);
    max-width: none;
    margin: 0;
  }

  /* Research insight -> system intervention: a plain divided list
     rather than another card grid, since this is a logical mapping,
     not a set of parallel items. A serif index number and a hand-drawn
     arrow (same displacement filter as the card icons) give it some
     rhythm; the arrow nudges forward on hover as a small sign of life. */
  .case-study__body :global(.insight-map) {
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
  }

  .case-study__body :global(.insight-row) {
    display: grid;
    grid-template-columns: auto 1fr auto 1fr;
    gap: var(--space-5);
    align-items: center;
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border);
  }

  .case-study__body :global(.insight-row:first-child) {
    border-top: none;
    padding-top: 0;
  }

  .case-study__body :global(.insight-number) {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--case-accent);
  }

  .case-study__body :global(.insight-from),
  .case-study__body :global(.insight-to) {
    max-width: none;
    margin: 0;
  }

  .case-study__body :global(.insight-from) {
    font-size: var(--text-caption);
    color: var(--color-muted);
  }

  .case-study__body :global(.insight-to) {
    font-size: var(--text-body);
    font-weight: 500;
    color: var(--color-text);
  }

  .case-study__body :global(.insight-to strong) {
    color: var(--case-accent-text);
    font-weight: 700;
  }

  .case-study__body :global(.insight-arrow) {
    width: 40px;
    height: 20px;
    flex-shrink: 0;
    color: var(--case-accent);
    filter: url(#sketch-wobble);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.insight-row:hover .insight-arrow) {
    transform: translateX(4px);
  }

  /* Same white/shadow/hover-lift family as .stat-card and
     .outcome-card (not the flat tinted .zone-card/.compare-card
     family) — a competitor card is a fact card like a stat, so it
     gets that card's shape, not an invented third one. Reads
     top-to-bottom instead of CBC's insight-map from/to arrows,
     because this project's argument is "here's the whole field,"
     not "here's one gap we're exploiting." */
  .case-study__body :global(.benchmark-grid) {
    display: grid;
    /* 2-up, not 4-up: four narrow, tall cards wrapped their list items
       onto several lines each and went ragged at anything under full
       desktop width. Two wider, squarer cards per row give each one
       enough room for the strength/weakness lists to sit side by side
       instead of stacked, so the card reads short instead of tall.
       minmax(0, 1fr), not plain 1fr: a plain 1fr track's automatic
       minimum is its item's min-content, so a card with an unbreakable
       run just a little wider than its share still forces the whole
       grid (and the page) wider instead of wrapping tighter. */
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.benchmark-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05), 0 16px 32px rgba(17, 17, 17, 0.06);
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.benchmark-card:hover) {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(17, 17, 17, 0.06), 0 20px 40px rgba(17, 17, 17, 0.1);
  }

  .case-study__body :global(.benchmark-header) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .case-study__body :global(.benchmark-logo) {
    display: block;
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    filter: url(#sketch-wobble);
  }

  .case-study__body :global(.benchmark-name) {
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    font-weight: 700;
    color: var(--color-text);
    margin: 0;
  }

  .case-study__body :global(.benchmark-purpose) {
    font-size: var(--text-caption);
    color: var(--color-muted);
    max-width: none;
    margin: 0;
    min-height: 2.8em;
  }

  .case-study__body :global(.benchmark-splits) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border);
  }

  .case-study__body :global(.benchmark-split) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.benchmark-split li) {
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    padding-left: var(--space-5);
    position: relative;
  }

  .case-study__body :global(.benchmark-split li::before) {
    position: absolute;
    left: 0;
    top: 0;
  }

  .case-study__body :global(.benchmark-split--strength li) {
    color: var(--color-text);
  }

  .case-study__body :global(.benchmark-split--strength li::before) {
    content: '+';
    color: var(--case-accent-text);
    font-weight: 700;
  }

  .case-study__body :global(.benchmark-split--weakness li) {
    color: var(--color-muted);
  }

  .case-study__body :global(.benchmark-split--weakness li::before) {
    content: '\2013';
  }

  /* The research wall: short, verbatim-feeling fragments grouped into
     columns, built on the same left-accent-rule grammar as
     .quote-card (this *is* a quote, just shorter) instead of an
     invented flat chip, so the raw texture of 74 responses reads as
     a native part of this design system rather than a bolt-on. */
  .case-study__body :global(.affinity-board) {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-6);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
    align-items: start;
  }

  .case-study__body :global(.affinity-column) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__body :global(.affinity-heading) {
    font-size: var(--text-label);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    margin: 0;
  }

  .case-study__body :global(.affinity-chip) {
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--color-text);
    background: var(--color-bg);
    padding: var(--space-4) var(--space-4) var(--space-4) var(--space-5);
    border-left: 3px solid var(--case-accent);
    margin: 0;
  }

  /* Rejected directions shown three-up instead of full-width figures,
     so comparing them costs a glance, not a scroll. */
  .case-study__body :global(.compare-card) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--color-card-warm);
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.compare-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(17, 17, 17, 0.1);
  }

  .case-study__body :global(.compare-card img) {
    background: var(--color-placeholder);
  }

  .case-study__body :global(.compare-label) {
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
    /* Reserves two lines so a longer label doesn't push this card's
       body copy down relative to siblings whose label fits one line. */
    min-height: 3.4em;
  }

  .case-study__body :global(.compare-card p) {
    font-size: var(--text-caption);
    color: var(--color-muted);
    max-width: none;
  }

  .case-study__body :global(.stat-grid),
  .case-study__body :global(.persona-grid),
  .case-study__body :global(.outcome-grid),
  .case-study__body :global(.compare-grid) {
    display: grid;
    gap: var(--space-5);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.stat-grid),
  .case-study__body :global(.outcome-grid),
  .case-study__body :global(.compare-grid) {
    grid-template-columns: repeat(3, 1fr);
  }

  .case-study__body :global(.persona-grid) {
    grid-template-columns: repeat(2, 1fr);
  }

  /* A class modifier instead of an inline style: an inline
     grid-template-columns always wins over the mobile media query
     below (inline style beats any stylesheet rule), so a 2-up grid
     stayed 2-up at phone width and overflowed the page. */
  .case-study__body :global(.stat-grid--2),
  .case-study__body :global(.screen-grid--2) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* A signature hand-sketched card: white ground, a loose-ink icon
     (clean SVG run through an SVG displacement filter so it reads as
     drawn, not vector-perfect) and the stat number in this project's
     own accent, so Qurate reads red and Conversations Before College
     reads blue instead of an unrelated rainbow. */
  .case-study__body :global(.stat-card),
  .case-study__body :global(.outcome-card) {
    position: relative;
    padding: var(--space-6);
    background: #fff;
    border-radius: 18px;
    box-shadow: 0 1px 2px rgba(17, 17, 17, 0.05), 0 16px 32px rgba(17, 17, 17, 0.06);
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.stat-card:hover),
  .case-study__body :global(.outcome-card:hover) {
    transform: translateY(-3px);
    box-shadow: 0 4px 8px rgba(17, 17, 17, 0.06), 0 20px 40px rgba(17, 17, 17, 0.1);
  }

  .case-study__body :global(.card-icon) {
    display: block;
    width: 112px;
    height: 112px;
    margin-bottom: var(--space-5);
    color: var(--color-text);
    filter: url(#sketch-wobble);
  }

  /* Qurate's brand icon style: medium-weight rounded strokes, a
     filled accent shape somewhere in each icon (a folded page corner,
     a cursor), and one confident curled/swept line per icon for
     personality, in the case's own accent color. */
  .case-study[data-icon-style='polished'] .case-study__body :global(.card-icon) {
    stroke-width: 4.5;
    color: var(--case-accent);
    filter: none;
  }

  .case-study__body :global(.stat-number) {
    position: relative;
    font-family: var(--font-serif);
    font-size: var(--text-stat);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--case-accent);
    margin: 0 0 var(--space-2);
  }

  .case-study__body :global(.stat-label) {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  /* A plain color-swatch grid for a style guide that has no single
     polished design-system export to show, built from tokens rather
     than screenshotted off a slide. */
  .case-study__body :global(.swatch-grid) {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--space-4);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.swatch) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .case-study__body :global(.swatch-color) {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 14px;
    border: 1px solid var(--color-border);
  }

  .case-study__body :global(.swatch-name) {
    font-size: var(--text-caption);
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .case-study__body :global(.swatch-hex) {
    font-size: var(--text-micro);
    color: var(--color-muted);
    margin: 0;
  }

  @media (max-width: 768px) {
    .case-study__body :global(.swatch-grid) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .case-study__body :global(.swatch-grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* Pairs the toggle with the grid it switches, the same flex-column
     rhythm a figure uses for its own header + content. */
  .case-study__body :global(.icon-showcase) {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  /* The real app icons, not a redrawn stand-in: shows the soft 3D
     style the Color Psychology paragraph above describes instead of
     asking the reader to take the claim on faith. */
  .case-study__body :global(.icon-grid) {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--space-4);
    margin-inline: 0;
    margin-bottom: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.icon-grid) :global(img) {
    width: 100%;
    height: auto;
    background: transparent;
  }

  @media (max-width: 768px) {
    .case-study__body :global(.icon-grid) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .case-study__body :global(.stat-card p:not(.stat-number):not(.stat-label)),
  .case-study__body :global(.outcome-card p) {
    font-size: var(--text-caption);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    max-width: none;
  }

  .case-study__body :global(.outcome-card h3) {
    font-family: var(--font-sans);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1.3;
    /* Reserves two lines regardless of whether this card's title wraps
       to one line or two, so the paragraph below always starts at the
       same baseline across a row of cards. */
    min-height: 2.6em;
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }

  .case-study__body :global(.persona-card) {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--color-card-warm);
    border-top: 3px solid var(--case-accent);
    transition: transform var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .case-study__body :global(.persona-card:hover) {
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(17, 17, 17, 0.1);
