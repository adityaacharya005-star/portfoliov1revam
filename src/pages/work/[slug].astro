---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
---

<Base title={data.title} description={data.description}>
  <article class="wrapper case-study">
    <header class="case-study__header">
      <p class="case-study__eyebrow">Case Study</p>
      <h1 class="case-study__title">{data.title}</h1>
      <p class="case-study__description">{data.description}</p>
      <dl class="case-study__meta">
        <div>
          <dt>Role</dt>
          <dd>{data.role}</dd>
        </div>
        <div>
          <dt>Timeline</dt>
          <dd>{data.timeline}</dd>
        </div>
        <div>
          <dt>Tools</dt>
          <dd>{data.tools.join(', ')}</dd>
        </div>
      </dl>
    </header>

    <div class="case-study__cover">
      <Image src={data.cover} alt={data.coverAlt} class="case-study__cover-image" />
    </div>

    <div class="case-study__body">
      <Content />
    </div>
  </article>

  <Contact />
</Base>

<style>
  .case-study {
    margin-top: var(--space-9);
    max-width: 760px;
  }

  .case-study__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__eyebrow {
    font-size: var(--text-small);
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-study__title {
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .case-study__description {
    font-size: var(--text-body-lg);
    color: var(--color-muted);
  }

  .case-study__meta {
    display: flex;
    gap: var(--space-7);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .case-study__meta dt {
    font-size: var(--text-small);
    color: var(--color-muted);
  }

  .case-study__meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-body);
  }

  .case-study__cover {
    margin-top: var(--space-8);
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .case-study__cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study__body {
    margin-top: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
  }

  .case-study__body :global(h2) {
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
    margin-bottom: var(--space-3);
  }

  .case-study__body :global(p) {
    font-size: var(--text-body);
    color: var(--color-text);
  }

  @media (max-width: 480px) {
    .case-study__title {
      font-size: 2rem;
    }

    .case-study__meta {
      gap: var(--space-5);
    }
  }
</style>
