---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';

export async function getStaticPaths() {
  const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: work[(i + 1) % work.length] },
  }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
---

<Base title={data.title} description={data.description} hideHeaderOnScroll>
  <div class="case-study" style={data.accentColor ? `--case-accent: ${data.accentColor}` : undefined}>
    <aside class="case-study__sidebar" aria-label="Case study sections">
      <a href="/work" class="case-study__breadcrumb">
        <span aria-hidden="true">&larr;</span> Work <span class="case-study__breadcrumb-sep">/</span>
        <span class="case-study__breadcrumb-title">{data.title}</span>
      </a>
      <nav>
        <ul class="case-study__nav" data-section-nav>
          {sections.map((s) => (
            <li>
              <a href={`#${s.slug}`} data-section-link={s.slug}>
                <span class="case-study__nav-bullet" aria-hidden="true"></span>
                {s.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <a href={`/work/${next.slug}`} class="case-study__next">
        Next <span aria-hidden="true">&rarr;</span>
      </a>
    </aside>

    <article class="case-study__main">
      <div class="case-study__cover">
        <Image src={data.cover} alt={data.coverAlt} class="case-study__cover-image" />
      </div>

      <div class="case-study__intro">
        <div class="case-study__intro-top">
          {data.eyebrow && <p class="case-study__eyebrow">{data.eyebrow}</p>}
          {data.slidesUrl && (
            <a href={data.slidesUrl} class="case-study__slides" target="_blank" rel="noopener noreferrer">
              View slides <span aria-hidden="true">&#8599;</span>
            </a>
          )}
        </div>
        <h1 class="case-study__title">{data.title}</h1>

        <dl class="case-study__meta">
          <div>
            <dt>Timeline</dt>
            <dd>{data.timeline}</dd>
          </div>
          <div>
            <dt>Role</dt>
            <dd>{data.role}</dd>
          </div>
          {data.services && (
            <div>
              <dt>Services</dt>
              <dd>{data.services.join(', ')}</dd>
            </div>
          )}
          <div>
            <dt>Tools</dt>
            <dd>{data.tools.join(', ')}</dd>
          </div>
        </dl>
      </div>

      <div class="case-study__body">
        <Content />
      </div>
    </article>
  </div>

  <Contact />
</Base>

<script>
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-section-link]');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.dataset.sectionLink!))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const setActive = (slug: string) => {
      links.forEach((link) => {
        link.classList.toggle('is-active', link.dataset.sectionLink === slug);
      });
    };

    // Picks the last heading whose top has scrolled above the trigger line —
    // i.e. the section currently being read. Plain scroll math rather than
    // IntersectionObserver margins, which create dead zones for short sections.
    const triggerLine = 140;
    let ticking = false;

    const updateActive = () => {
      ticking = false;
      const atBottom =
        window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
      if (atBottom) {
        setActive(sections[sections.length - 1].id);
        return;
      }
      let current = sections[0];
      for (const section of sections) {
        if (section.getBoundingClientRect().top <= triggerLine) {
          current = section;
        }
      }
      setActive(current.id);
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateActive);
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    updateActive();
  }
</script>

<style>
  .case-study {
    --case-accent: var(--color-accent);
    max-width: 1320px;
    /* Anchor the left edge to the same position as the header's
       .wrapper (max-width 1200, centered) and only extend further
       right, so the sidebar always lines up under the avatar/nav
       instead of the two containers centering independently. */
    margin-left: max(calc((100vw - var(--layout-max-width)) / 2), 0px);
    margin-right: auto;
    margin-top: var(--space-9);
    padding-inline: var(--layout-padding);
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .case-study__sidebar {
    position: sticky;
    top: calc(90px + var(--space-5)); /* clears the sticky header's own height */
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .case-study__breadcrumb {
    display: block;
    font-size: var(--text-small);
    color: var(--color-muted);
    text-decoration: none;
  }

  .case-study__breadcrumb-sep {
    margin: 0 var(--space-1);
  }

  .case-study__breadcrumb-title {
    color: var(--color-text);
  }

  .case-study__nav {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .case-study__nav a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-body);
    color: var(--color-muted);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .case-study__nav-bullet {
    width: 6px;
    height: 6px;
    flex-shrink: 0;
    background: transparent;
    transition: background var(--duration-fast) var(--ease-standard);
  }

  .case-study__nav a.is-active {
    color: var(--color-accent);
  }

  .case-study__nav a.is-active .case-study__nav-bullet {
    background: var(--color-accent);
  }

  .case-study__next {
    font-size: var(--text-small);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text);
    text-decoration: none;
  }

  .case-study__cover {
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .case-study__cover-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study__intro {
    margin-top: var(--space-7);
  }

  .case-study__intro-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  .case-study__eyebrow {
    margin: 0;
    font-size: var(--text-small);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .case-study__slides {
    font-size: var(--text-small);
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .case-study__title {
    margin-top: var(--space-3);
    font-size: var(--text-h2);
    line-height: var(--leading-tight);
  }

  .case-study__meta {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
  }

  .case-study__meta dt {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .case-study__meta dd {
    margin: var(--space-1) 0 0;
    font-size: var(--text-body);
  }

  .case-study__body {
    margin-top: var(--space-8);
  }

  /* Rhythm: tight between a heading and what follows it right away,
     loose before the next heading/section, medium between consecutive
     paragraphs — so sections scan as distinct chunks instead of a
     uniform wall of text. */
  .case-study__body > :global(* + *) {
    margin-top: var(--space-9);
  }

  .case-study__body > :global(h2 + p) {
    margin-top: var(--space-3);
  }

  /* A grid/figure right after a heading (no lead paragraph in between)
     needs more breathing room than text does — tight works for prose
     continuing the heading's thought, not for a card grid or image. */
  .case-study__body > :global(h2 + ul),
  .case-study__body > :global(h2 + figure) {
    margin-top: var(--space-6);
  }

  .case-study__body > :global(p + p) {
    margin-top: var(--space-4);
  }

  .case-study__body :global(h2) {
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
    scroll-margin-top: var(--space-8);
  }

  .case-study__body :global(p) {
    max-width: 720px;
    font-size: var(--text-body);
    line-height: var(--leading-normal);
    color: var(--color-text);
  }

  .case-study__body :global(p strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  /* Diagrams / UI screenshots embedded in the body: shown at natural
     aspect ratio (never cropped), placeholder bg while loading. */
  .case-study__body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    background: var(--color-placeholder);
  }

  /* Framed like a card rather than bleeding edge-to-edge: padded,
     tinted background behind the screenshot/diagram. */
  .case-study__body :global(figure) {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    background: var(--color-card-warm);
  }

  .case-study__body :global(figcaption) {
    font-size: var(--text-small);
    color: var(--color-muted);
    max-width: 720px;
  }

  .case-study__body :global(.stat-grid),
  .case-study__body :global(.persona-grid),
  .case-study__body :global(.outcome-grid) {
    display: grid;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .case-study__body :global(.stat-grid),
  .case-study__body :global(.outcome-grid) {
    grid-template-columns: repeat(3, 1fr);
  }

  .case-study__body :global(.persona-grid) {
    grid-template-columns: repeat(2, 1fr);
  }

  .case-study__body :global(.stat-card),
  .case-study__body :global(.outcome-card) {
    position: relative;
    overflow: hidden;
    padding: var(--space-5);
    background: var(--color-card-warm);
  }

  .case-study__body :global(.stat-card::before),
  .case-study__body :global(.outcome-card::before) {
    content: '';
    position: absolute;
    top: -30px;
    right: -30px;
    width: 110px;
    height: 110px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--case-accent) 16%, transparent);
    pointer-events: none;
  }

  .case-study__body :global(.card-icon) {
    position: relative;
    display: block;
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-4);
    color: var(--case-accent);
  }

  .case-study__body :global(.stat-number) {
    position: relative;
    font-family: var(--font-serif);
    font-size: var(--text-h3);
    color: var(--case-accent);
    margin: 0 0 var(--space-2);
  }

  .case-study__body :global(.stat-label) {
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }

  .case-study__body :global(.stat-card p),
  .case-study__body :global(.outcome-card p) {
    font-size: var(--text-small);
    color: var(--color-muted);
    max-width: none;
  }

  .case-study__body :global(.outcome-card h3) {
    font-family: var(--font-sans);
    font-size: var(--text-body-lg);
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }

  .case-study__body :global(.persona-card) {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: var(--space-5);
    align-items: flex-start;
    padding: var(--space-5);
    background: var(--color-card-warm);
  }

  .case-study__body :global(.persona-card::before) {
    content: '';
    position: absolute;
    bottom: -40px;
    left: -40px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--case-accent) 12%, transparent);
    pointer-events: none;
  }

  .case-study__body :global(.persona-card > div) {
    position: relative;
  }

  .case-study__body :global(.persona-portrait) {
    position: relative;
    width: 96px;
    height: 96px;
    flex-shrink: 0;
    background: var(--color-placeholder);
    object-fit: cover;
    object-position: top;
  }

  .case-study__body :global(.persona-card dl) {
    margin: var(--space-3) 0 0;
  }

  .case-study__body :global(.persona-eyebrow) {
    font-size: var(--text-small);
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0;
  }

  .case-study__body :global(.persona-name) {
    font-size: var(--text-body-lg);
    font-weight: 600;
    margin: var(--space-1) 0 0;
  }

  .case-study__body :global(.persona-role) {
    font-size: var(--text-small);
    color: var(--color-muted);
    margin: 0 0 var(--space-3);
  }

  @media (max-width: 768px) {
    .case-study__body :global(.stat-grid),
    .case-study__body :global(.outcome-grid),
    .case-study__body :global(.persona-grid) {
      grid-template-columns: 1fr;
    }

    .case-study__body :global(.persona-card) {
      flex-direction: column;
    }
  }

  @media (max-width: 1024px) {
    .case-study {
      padding-inline: var(--layout-padding-tablet);
      grid-template-columns: 180px 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 768px) {
    .case-study {
      display: block;
    }

    .case-study__sidebar {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      margin-bottom: var(--space-6);
    }

    .case-study__nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-4);
    }

    .case-study__next {
      margin-left: auto;
    }
  }

  @media (max-width: 480px) {
    .case-study {
      padding-inline: var(--layout-padding-mobile);
    }

    .case-study__title {
      font-size: 2rem;
    }

    .case-study__meta {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
