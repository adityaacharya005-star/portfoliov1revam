---
import { getImage } from 'astro:assets';
import { site } from '../data/site';
import { squigglePath } from '../lib/squiggle';
import footerPosterSrc from '../assets/images/footer-poster.png';

const footerPoster = await getImage({ src: footerPosterSrc, width: 1280 });
---

<section class="section contact">
  <div class="wrapper contact__divider" aria-hidden="true">
    <svg viewBox="0 0 24 10" preserveAspectRatio="none"><path d={squigglePath('footer-divider')} /></svg>
  </div>
  <div class="contact__scene">
    <video
      class="contact__scene-video"
      poster={footerPoster.src}
      autoplay
      loop
      muted
      playsinline
      disablepictureinpicture
      disableRemotePlayback
      controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
      aria-label="Looping pixel-art animation of a café scene, a figure at the counter drinking coffee"
      data-footer-video
    >
      <source src="/videos/footer-loop.webm" type="video/webm" />
      <source src="/videos/footer-loop.mp4" type="video/mp4" />
    </video>
    <div class="contact__scrim" aria-hidden="true"></div>
    <div class="wrapper contact__content">
      <!-- The one deliberately oversized moment on the site - the hero
           opens the page with a mixed roman/italic sentence, this closes
           it the same way, so the two read as one voice bookending the
           whole portfolio rather than a generic big "let's talk" CTA. -->
      <h2 class="contact__headline" data-headline>
        Would love to <em class="contact__connect">connect<svg class="contact__connect-underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath('footer-connect-underline')} /></svg></em>.
      </h2>
      <div class="contact__meta">
        <a href={`mailto:${site.email}`} class="underline-link contact__email">{site.email}</a>
        <div class="contact__links">
          <a href={site.linkedinUrl} class="contact__link underline-link" target="_blank" rel="noopener noreferrer">
            <svg class="contact__link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="10" r="3"/><path d="M7 18c0-3 2.2-5 5-5s5 2 5 5"/></svg>
            <span class="contact__link-text">linkedin</span>
          </a>
          <a href={site.behanceUrl} class="contact__link underline-link" target="_blank" rel="noopener noreferrer">
            <svg class="contact__link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 15l5-5 4 4 3-3 6 6"/><circle cx="8" cy="9" r="1.1" fill="currentColor" stroke="none"/></svg>
            <span class="contact__link-text">behance</span>
          </a>
          <a href={site.resumeUrl} class="contact__link underline-link" target="_blank" rel="noopener noreferrer">
            <svg class="contact__link-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6Z"/><path d="M14 3v4h4"/><path d="M9 12h6M9 15h6M9 18h3"/></svg>
            <span class="contact__link-text">resume</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // The underline draws itself in once, the first time the footer
  // scrolls into view - gated the same way as the case-study body's
  // reveal, so it's never hidden without both motion and
  // IntersectionObserver support.
  document.addEventListener('astro:page-load', () => {
    const headline = document.querySelector<HTMLElement>('[data-headline]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (headline && !prefersReducedMotion && 'IntersectionObserver' in window) {
      headline.setAttribute('data-reveal', '');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-revealed');
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.6 },
      );
      observer.observe(headline);
    }

    // This component (unlike the hero) renders on every page, some of
    // which never load WorkCard's own script - so the footer video's
    // reduced-motion handling can't borrow that one and has to be its
    // own, scoped to its own attribute rather than reusing
    // data-autoplay-video and risking the two scripts double-handling
    // the same element on pages that do load both.
    const footerVideo = document.querySelector<HTMLVideoElement>('[data-footer-video]');
    if (footerVideo && prefersReducedMotion) {
      footerVideo.removeAttribute('autoplay');
      footerVideo.pause();
      footerVideo.currentTime = 0;
    }
  });
</script>

<style>
  /* A hand-drawn closing rule instead of the page just stopping - the
     same squiggle used under work-card titles, stretched the full
     content width, so the sketchbook gets a last stroke of its own
     ink rather than an abrupt cut to the end of the page. */
  .contact__divider {
    margin-bottom: var(--space-8);
  }

  /* Full-bleed: the one place on the site that breaks out of
     .wrapper's max-width, because the brief here is specifically a
     scene filling the entire footer, not a framed photo within the
     content column like the work-card thumbs. object-fit: cover (not
     aspect-ratio) is what actually guarantees no empty strip on any
     edge - the box's own height can be anything and the video still
     fills it exactly, where aspect-ratio would letterbox the instant
     the box's proportions didn't match the source's. Sharp corners
     still carried over: nothing on the site gets a border-radius. */
  .contact__scene {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    min-height: clamp(480px, 62vw, 760px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .contact__scene-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Guarantees the overlaid text reads regardless of which part of a
     fairly busy, mixed-light scene happens to sit behind it - without
     this, the headline would be legible over the dark shelving but
     not over the lit countertop right below it. */
  .contact__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(17, 13, 10, 0) 35%, rgba(17, 13, 10, 0.72) 100%);
    pointer-events: none;
  }

  .contact__divider svg {
    display: block;
    width: 100%;
    height: 14px;
    overflow: visible;
  }

  .contact__divider path {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.6;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0.6;
  }

  /* Local, scene-only text colors: the rest of the site's palette is
     tuned for dark text on the cream background, which has no
     contrast left to give once that background is a dark video.
     Generous padding keeps the text clear of the scene's edges on
     every side, not just resting on the scrim at the bottom. */
  .contact__content {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    padding-block: var(--space-8);
    --scene-text: #f8f4ec;
    --scene-muted: rgb(248 244 236 / 76%);
    --scene-ink: #e7bd72;
  }

  .contact__headline {
    font-size: var(--text-footer);
    line-height: var(--leading-tight);
    max-width: 16ch;
    color: var(--scene-text);
  }

  .contact__headline em {
    font-style: italic;
  }

  .contact__connect {
    position: relative;
    display: inline-block;
  }

  /* A hand-inked underline for the one word doing the asking, drawn
     on once the footer comes into view - the same squiggle vocabulary
     as the divider above and the nav underlines elsewhere, not a new
     decorative device, just the biggest use of it on the site. Starts
     fully drawn (data-reveal unset) so nothing is hidden without JS
     or when reduced motion is on; the script below only ever adds the
     hidden starting state for the one case where it can animate in. */
  .contact__connect-underline {
    position: absolute;
    left: -2%;
    bottom: -0.1em;
    width: 104%;
    height: 0.22em;
    overflow: visible;
    pointer-events: none;
  }

  .contact__connect-underline path {
    fill: none;
    stroke: var(--scene-ink);
    stroke-width: 2.2;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0.9;
  }

  /* data-reveal is only ever added by the script below, once it has
     confirmed motion is allowed and IntersectionObserver exists - the
     hidden starting state below can never outlive either of those. */
  [data-headline][data-reveal] .contact__connect-underline path {
    stroke-dasharray: 32;
    stroke-dashoffset: 32;
    opacity: 0;
    transition: stroke-dashoffset 900ms var(--ease-entrance), opacity 250ms var(--ease-standard);
  }

  [data-headline][data-reveal].is-revealed .contact__connect-underline path {
    stroke-dashoffset: 0;
    opacity: 0.9;
  }

  /* The headline is the one bold move; everything that actually does
     something (the mailto link, the socials) stays this quiet so it
     doesn't compete with it, the way the hero's own heading stays
     louder than the nav sitting above it. */
  .contact__meta {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }

  .contact__email {
    color: var(--scene-muted);
    font-size: var(--text-body-lg);
    overflow-wrap: anywhere;
  }

  .contact__links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    font-size: var(--text-body);
    text-transform: lowercase;
    flex-shrink: 0;
    color: var(--scene-text);
  }

  /* Overrides .underline-link's global hover color (the site-wide
     maroon accent, tuned for dark text on the cream background) -
     against this scene's dark scrim it would barely read at all, so
     this scene brightens to its own warm ink color instead. */
  .contact__content .underline-link:hover,
  .contact__content .underline-link:focus-visible {
    color: var(--scene-ink);
  }

  /* .underline-link's own text-decoration doesn't render once its
     element becomes a flex container (every current browser silently
     drops text-decoration on flex/inline-flex boxes), so the
     underline moves to .contact__link-text, an ordinary inline child,
     while .underline-link still supplies the hover/focus color swap
     and the mobile 44px tap target. */
  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
  }

  .contact__link-text {
    text-decoration: underline;
    text-decoration-color: currentColor;
    text-underline-offset: 3px;
  }

  /* Same loose-ink filter as the rest of the site's iconography, at
     the small scale it was actually tuned for (the TOC dash, this),
     rather than the bigger sketch-wobble built for 112px card icons.
     No separate hover color: the icon's currentColor already follows
     whatever .underline-link sets on the shared anchor. */
  .contact__link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
    filter: url(#sketch-wobble-small);
    transform-origin: center;
  }

  /* A small hand-nudged wiggle on hover/focus, like the icon's own
     ink got jostled - answers the person's pointer the way the rest
     of the site's hovers do, rather than just swapping a color. */
  .contact__link:hover .contact__link-icon,
  .contact__link:focus-visible .contact__link-icon {
    animation: contact-icon-wiggle 320ms var(--ease-standard);
  }

  @keyframes contact-icon-wiggle {
    0% {
      transform: rotate(0deg);
    }
    30% {
      transform: rotate(-8deg);
    }
    65% {
      transform: rotate(6deg);
    }
    100% {
      transform: rotate(0deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact__link:hover .contact__link-icon,
    .contact__link:focus-visible .contact__link-icon {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .contact__scene {
      min-height: clamp(420px, 92vw, 560px);
    }

    /* The mobile crop (a shorter, closer-to-square box) lands the
       email/links row over a lighter stretch of countertop than the
       desktop crop does - still above the contrast floor there, but
       with less margin, so this scrim goes darker and starts higher
       to cover more of that lighter area. */
    .contact__scrim {
      background: linear-gradient(to bottom, rgba(17, 13, 10, 0) 15%, rgba(17, 13, 10, 0.86) 100%);
    }

    .contact__content {
      padding-block: var(--space-6) var(--space-7);
    }

    .contact__meta {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-4);
    }

    .contact__links {
      gap: var(--space-4);
    }
  }
</style>
