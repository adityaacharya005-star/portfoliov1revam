---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  cover: ImageMetadata;
  coverAlt: string;
}

const { href, title, description, cover, coverAlt } = Astro.props;
---

<a href={href} class="work-card">
  <span class="work-card__media">
    <Image src={cover} alt={coverAlt} class="work-card__image" />
  </span>
  <span class="work-card__title">{title}</span>
  <span class="work-card__description">{description}</span>
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .work-card__media {
    display: block;
    width: 100%;
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__image,
  .work-card:focus-visible .work-card__image {
    transform: scale(1.02);
  }

  .work-card__title {
    display: block;
    margin-top: var(--space-4);
    font-size: var(--text-body-lg);
    color: var(--color-text);
  }

  .work-card__description {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-muted);
  }
</style>
