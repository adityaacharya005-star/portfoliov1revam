---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  cover: ImageMetadata;
  coverAlt: string;
  tags?: string[];
}

const { href, title, description, cover, coverAlt, tags } = Astro.props;
---

<a href={href} class="work-card">
  <span class="work-card__media">
    <Image src={cover} alt={coverAlt} class="work-card__image" />
  </span>
  <span class="work-card__top">
    <span class="work-card__title">
      <span class="work-card__title-text">{title}</span>
      <span class="work-card__arrow" aria-hidden="true">&rarr;</span>
    </span>
    {tags && tags.length > 0 && (
      <span class="work-card__tags">
        {tags.map((tag) => (
          <span class="work-card__tag">{tag}</span>
        ))}
      </span>
    )}
  </span>
  <span class="work-card__description">{description}</span>
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .work-card__media {
    display: block;
    width: 100%;
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__image,
  .work-card:focus-visible .work-card__image {
    transform: scale(1.02);
  }

  .work-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .work-card__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .work-card__title-text {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .work-card__arrow {
    flex-shrink: 0;
    font-size: 0.875rem;
    line-height: 1;
    color: var(--color-muted);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__arrow,
  .work-card:focus-visible .work-card__arrow {
    transform: translateX(3px);
  }

  .work-card__tags {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1);
  }

  .work-card__tag {
    padding: 0.1875rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-placeholder) 45%, var(--color-bg));
    border-radius: 999px;
    white-space: nowrap;
  }

  .work-card__description {
    display: block;
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .work-card__top {
      flex-wrap: wrap;
    }

    .work-card__title-text {
      overflow: visible;
      white-space: normal;
    }
  }
</style>
