---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { squigglePath } from '../lib/squiggle';

interface Props {
  href: string;
  title: string;
  description: string;
  cover: ImageMetadata;
  coverAlt: string;
  tags?: string[];
  thumbVideoMp4?: string;
  thumbVideoWebm?: string;
  accentColor?: string;
}

const { href, title, description, cover, coverAlt, tags, thumbVideoMp4, thumbVideoWebm, accentColor } = Astro.props;
const hasVideo = Boolean(thumbVideoMp4 && thumbVideoWebm);
const poster = hasVideo ? await getImage({ src: cover, width: 960 }) : null;
---

<a
  href={href}
  class="work-card"
  style={accentColor ? `--card-accent: ${accentColor}` : undefined}
>
  <span class="work-card__media">
    {hasVideo ? (
      <video
        class="work-card__image"
        poster={poster!.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label={coverAlt}
        data-autoplay-video
      >
        <source src={thumbVideoWebm} type="video/webm" />
        <source src={thumbVideoMp4} type="video/mp4" />
      </video>
    ) : (
      <Image src={cover} alt={coverAlt} class="work-card__image" />
    )}
  </span>
  <span class="work-card__top">
    <span class="work-card__title">
      <span class="work-card__title-text">
        {title}
        <svg class="work-card__underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath(`${title}-underline`)} /></svg>
      </span>
      <svg class="work-card__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
    {tags && tags.length > 0 && (
      <span class="work-card__tags">
        {tags.map((tag) => (
          <span class="work-card__tag">{tag}</span>
        ))}
      </span>
    )}
  </span>
  <span class="work-card__description">{description}</span>
</a>

<script>
  // Re-run on every view-transition navigation, not just the first time
  // this card's markup appears (see Header.astro for why this event
  // instead of data-astro-rerun).
  document.addEventListener('astro:page-load', () => {
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-autoplay-video]');
    if (videos.length > 0 && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      videos.forEach((video) => {
        video.removeAttribute('autoplay');
        video.pause();
        video.currentTime = 0;
      });
    }
  });
</script>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .work-card__media {
    display: block;
    width: 100%;
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__image,
  .work-card:focus-visible .work-card__image {
    transform: scale(1.02);
  }

  .work-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .work-card__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__title,
  .work-card:focus-visible .work-card__title {
    color: var(--card-accent, var(--color-accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__title {
      transition: none;
    }
  }

  .work-card__title-text {
    position: relative;
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-bottom: 6px;
  }

  /* The same hand-drawn squiggle as the case study pages' TOC, in
     place of a straight underline, so the signature "you're looking at
     a sketch, not a template" detail shows up here too, the first
     place a visitor's cursor actually touches the work. Seeded off the
     title, so every card's stroke is slightly different, and tinted to
     --card-accent (that project's own color) rather than a generic
     site-wide one. */
  .work-card__underline {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 7px;
    overflow: visible;
    pointer-events: none;
  }

  .work-card__underline path {
    fill: none;
    stroke: var(--card-accent, var(--color-accent));
    stroke-width: 1.6;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0;
    transform: scaleX(0.9);
    transform-origin: left center;
    transition: opacity var(--duration-fast) var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .work-card:hover .work-card__underline path,
  .work-card:focus-visible .work-card__underline path {
    opacity: 0.85;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__underline path {
      transition: none;
    }
  }

  .work-card__arrow {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--color-muted);
    transition: transform var(--duration-fast) var(--ease-standard),
      color var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__arrow,
  .work-card:focus-visible .work-card__arrow {
    transform: translateX(3px);
    color: var(--card-accent, var(--color-text));
  }

  .work-card__tags {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1);
  }

  .work-card__tag {
    padding: 0.1875rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-placeholder) 45%, var(--color-bg));
    border-radius: 999px;
    white-space: nowrap;
  }

  .work-card__description {
    display: block;
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .work-card__top {
      flex-wrap: wrap;
    }

    .work-card__title-text {
      overflow: visible;
      white-space: normal;
    }
  }
</style>
