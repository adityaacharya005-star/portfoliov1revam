---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  description: string;
  cover: ImageMetadata;
  coverAlt: string;
  tags?: string[];
}

const { href, title, description, cover, coverAlt, tags } = Astro.props;
---

<a href={href} class="work-card">
  <span class="work-card__media">
    <Image src={cover} alt={coverAlt} class="work-card__image" />
  </span>
  <span class="work-card__top">
    <span class="work-card__title">
      {title}
      <svg class="work-card__arrow" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path
          d="M3 11L11 3M11 3H4.5M11 3V9.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </span>
    {tags && tags.length > 0 && (
      <span class="work-card__tags">
        {tags.map((tag) => (
          <span class="work-card__tag">{tag}</span>
        ))}
      </span>
    )}
  </span>
  <span class="work-card__description">{description}</span>
</a>

<style>
  .work-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .work-card__media {
    display: block;
    width: 100%;
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__image,
  .work-card:focus-visible .work-card__image {
    transform: scale(1.02);
  }

  .work-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
    flex-wrap: wrap;
  }

  .work-card__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--color-text);
  }

  .work-card__arrow {
    flex-shrink: 0;
    width: 12px;
    height: 12px;
    color: var(--color-muted);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__arrow,
  .work-card:focus-visible .work-card__arrow {
    transform: translate(2px, -2px);
  }

  .work-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .work-card__tag {
    padding: 0.1875rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-placeholder) 45%, var(--color-bg));
    border-radius: 999px;
    white-space: nowrap;
  }

  .work-card__description {
    display: block;
    margin-top: var(--space-2);
    font-size: var(--text-small);
    color: var(--color-muted);
  }
</style>
