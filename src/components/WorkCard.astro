---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { squigglePath } from '../lib/squiggle';
import { darkenUntilContrast, hexToRgb, mixRgb } from '../lib/color';

interface Props {
  href: string;
  title: string;
  description: string;
  cover: ImageMetadata;
  coverAlt: string;
  tags?: string[];
  thumbVideoMp4?: string;
  thumbVideoWebm?: string;
  accentColor?: string;
}

const { href, title, description, cover, coverAlt, tags, thumbVideoMp4, thumbVideoWebm, accentColor } = Astro.props;
const hasVideo = Boolean(thumbVideoMp4 && thumbVideoWebm);
const poster = hasVideo ? await getImage({ src: cover, width: 960 }) : null;

// The custom cursor's label sits on a filled circle in the project's
// accent, with white text on top — several accents (the orange, the
// pink) don't clear 4.5:1 against plain white, so darken a copy of the
// accent specifically for this use rather than reusing the raw color.
const cursorFill = accentColor ? darkenUntilContrast(accentColor, [255, 255, 255], 4.5) : undefined;

// The tag pill's hover background is only a 14% tint of the accent
// over --color-bg (kept light on purpose, so the pill still reads as a
// label, not a solid button) — but that leaves the accent itself, used
// as the text color, well under 4.5:1 for every project's hue (as low
// as 2.1:1 for the orange). Mirror that same color-mix here so the text
// color can be darkened against the *actual* resulting background
// rather than an approximation.
const colorBg = hexToRgb('#f1eee8');
const tagHoverBg = accentColor ? mixRgb(hexToRgb(accentColor), colorBg, 14) : colorBg;
const tagText = accentColor ? darkenUntilContrast(accentColor, tagHoverBg, 4.5) : undefined;
---

<a
  href={href}
  class="work-card"
  style={`${accentColor ? `--card-accent: ${accentColor};` : ''}${cursorFill ? `--cursor-fill: ${cursorFill};` : ''}${tagText ? `--tag-text: ${tagText};` : ''}`}
>
  <span class="work-card__cursor" aria-hidden="true" data-card-cursor>
    <span class="work-card__cursor-dot">View</span>
  </span>
  <span class="work-card__media">
    {hasVideo ? (
      <video
        class="work-card__image"
        poster={poster!.src}
        autoplay
        loop
        muted
        playsinline
        disablepictureinpicture
        controlslist="nodownload noremoteplayback nofullscreen noplaybackrate"
        aria-label={coverAlt}
        data-autoplay-video
      >
        <source src={thumbVideoWebm} type="video/webm" />
        <source src={thumbVideoMp4} type="video/mp4" />
      </video>
    ) : (
      <Image src={cover} alt={coverAlt} class="work-card__image" />
    )}
  </span>
  <span class="work-card__top">
    <span class="work-card__title">
      <span class="work-card__title-text">
        {title}
        <svg class="work-card__underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath(`${title}-underline`)} /></svg>
      </span>
      <svg class="work-card__arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
    {tags && tags.length > 0 && (
      <span class="work-card__tags">
        {tags.map((tag) => (
          <span class="work-card__tag">{tag}</span>
        ))}
      </span>
    )}
  </span>
  <span class="work-card__description">{description}</span>
</a>

<script>
  // Re-run on every view-transition navigation, not just the first time
  // this card's markup appears (see Header.astro for why this event
  // instead of data-astro-rerun).
  document.addEventListener('astro:page-load', () => {
    const videos = document.querySelectorAll<HTMLVideoElement>('[data-autoplay-video]');
    if (videos.length > 0 && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      videos.forEach((video) => {
        video.removeAttribute('autoplay');
        video.pause();
        video.currentTime = 0;
      });
    }
  });

  // The scoped work-card cursor: a small "View" dot that follows the
  // pointer, only while it's over a card, only on devices with a real
  // mouse (hover + a fine pointer — never touch), and never under
  // reduced motion. Position is JS-driven with its own light lerp
  // smoothing (not a CSS transition — that would fight a value changing
  // every mousemove); the dot's own scale/opacity/blur entrance is
  // handled separately in CSS so the two don't fight over `transform`.
  document.addEventListener('astro:page-load', () => {
    const win = window as unknown as { __cardCursorCleanup?: () => void };
    win.__cardCursorCleanup?.();

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const supportsFineHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    if (prefersReducedMotion || !supportsFineHover) return;

    const cleanups: Array<() => void> = [];

    document.querySelectorAll<HTMLAnchorElement>('.work-card').forEach((card) => {
      const follower = card.querySelector<HTMLElement>('[data-card-cursor]');
      if (!follower) return;

      // Position tracks the pointer's viewport coordinates against the
      // card's rect, re-measured every frame rather than only on
      // mousemove. Scrolling moves the card under a stationary pointer
      // without firing any mouse event, so a version that only updated
      // on mousemove would freeze mid-scroll while the card (and the
      // rest of the page) kept moving under it.
      let lastClientX = 0;
      let lastClientY = 0;
      let curX = 0;
      let curY = 0;
      let raf = 0;
      let active = false;

      const render = () => {
        const rect = card.getBoundingClientRect();
        const targetX = lastClientX - rect.left;
        const targetY = lastClientY - rect.top;
        curX += (targetX - curX) * 0.2;
        curY += (targetY - curY) * 0.2;
        follower.style.transform = `translate(${curX}px, ${curY}px)`;
        if (active) raf = requestAnimationFrame(render);
      };

      const onMove = (e: MouseEvent) => {
        lastClientX = e.clientX;
        lastClientY = e.clientY;
      };

      const onEnter = (e: MouseEvent) => {
        lastClientX = e.clientX;
        lastClientY = e.clientY;
        const rect = card.getBoundingClientRect();
        curX = e.clientX - rect.left;
        curY = e.clientY - rect.top;
        follower.style.transform = `translate(${curX}px, ${curY}px)`;
        active = true;
        card.classList.add('is-cursor-active');
        card.addEventListener('mousemove', onMove);
        raf = requestAnimationFrame(render);
      };

      const onLeave = () => {
        active = false;
        cancelAnimationFrame(raf);
        card.classList.remove('is-cursor-active');
        card.removeEventListener('mousemove', onMove);
      };

      card.classList.add('has-custom-cursor');
      card.addEventListener('mouseenter', onEnter);
      card.addEventListener('mouseleave', onLeave);

      cleanups.push(() => {
        active = false;
        cancelAnimationFrame(raf);
        card.classList.remove('has-custom-cursor', 'is-cursor-active');
        card.removeEventListener('mouseenter', onEnter);
        card.removeEventListener('mouseleave', onLeave);
        card.removeEventListener('mousemove', onMove);
      });
    });

    win.__cardCursorCleanup = () => cleanups.forEach((fn) => fn());
  });
</script>

<style>
  .work-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* Only swap away the real cursor once the replacement is actually
     running (the class is added by the script that also checks
     hover+fine-pointer and reduced motion) — never from CSS alone, or
     a browser without that JS path would just lose its cursor. */
  .work-card.has-custom-cursor:hover {
    cursor: none;
  }

  .work-card__cursor {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
    z-index: 2;
  }

  .work-card__cursor-dot {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: #fff;
    font-size: 0.5625rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0;
    filter: blur(4px);
    transform: translate(-50%, -50%) scale(0.25);
    transition: opacity var(--duration-fast) var(--ease-standard),
      filter var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  /* The fill lives on ::before, not the badge itself, so the hand-drawn
     wobble filter below only touches the circle's edge — the "View"
     text stays crisp instead of getting displaced along with it. */
  .work-card__cursor-dot::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: var(--cursor-fill, var(--color-accent));
    filter: url(#sketch-wobble-badge);
  }

  .work-card.is-cursor-active .work-card__cursor-dot {
    opacity: 1;
    filter: blur(0);
    transform: translate(-50%, -50%) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__cursor-dot {
      transition: none;
    }
  }

  .work-card__media {
    display: block;
    width: 100%;
    aspect-ratio: var(--card-aspect-ratio);
    overflow: hidden;
    background: var(--color-placeholder);
  }

  .work-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__image,
  .work-card:focus-visible .work-card__image {
    transform: scale(1.02);
  }

  .work-card__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .work-card__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-width: 0;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-text);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__title,
  .work-card:focus-visible .work-card__title {
    color: var(--card-accent, var(--color-accent));
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__title {
      transition: none;
    }
  }

  .work-card__title-text {
    position: relative;
    display: inline-block;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-bottom: 6px;
  }

  /* The same hand-drawn squiggle as the case study pages' TOC, in
     place of a straight underline, so the signature "you're looking at
     a sketch, not a template" detail shows up here too, the first
     place a visitor's cursor actually touches the work. Seeded off the
     title, so every card's stroke is slightly different, and tinted to
     --card-accent (that project's own color) rather than a generic
     site-wide one. */
  .work-card__underline {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 7px;
    overflow: visible;
    pointer-events: none;
  }

  .work-card__underline path {
    fill: none;
    stroke: var(--card-accent, var(--color-accent));
    stroke-width: 1.6;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0;
    transform: scaleX(0.9);
    transform-origin: left center;
    transition: opacity var(--duration-fast) var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .work-card:hover .work-card__underline path,
  .work-card:focus-visible .work-card__underline path {
    opacity: 0.85;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__underline path,
    .work-card__arrow {
      transition: none;
    }
  }

  /* Hidden at rest rather than sitting there unconditionally: the card
     already says "this is clickable" three other ways on hover (the
     title's color, the hand-drawn underline, the image's zoom), so the
     arrow's job is just to reinforce direction once that intent is
     already there, not to advertise clickability on its own. */
  .work-card__arrow {
    flex-shrink: 0;
    width: 14px;
    height: 14px;
    color: var(--card-accent, var(--color-text));
    opacity: 0;
    filter: blur(4px);
    transform: scale(0.25) translateX(-2px);
    transition: opacity var(--duration-fast) var(--ease-standard),
      filter var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .work-card:hover .work-card__arrow,
  .work-card:focus-visible .work-card__arrow {
    opacity: 1;
    filter: blur(0);
    transform: scale(1) translateX(3px);
  }

  .work-card__tags {
    display: flex;
    flex-shrink: 0;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--space-1);
  }

  .work-card__tag {
    padding: 0.1875rem 0.5rem;
    font-size: 0.6875rem;
    color: var(--color-muted);
    background: color-mix(in srgb, var(--color-placeholder) 45%, var(--color-bg));
    border-radius: 999px;
    white-space: nowrap;
    transition: color var(--duration-fast) var(--ease-standard),
      background var(--duration-fast) var(--ease-standard);
  }

  /* Gray at rest, not accent: the same tag text ("Product Design")
     repeats across different projects, so tinting it permanently would
     make one tag's color mean "this project" on one card and nothing
     in particular on the next. On hover there's no such ambiguity —
     it's clearly this card's color for as long as the pointer is here. */
  .work-card:hover .work-card__tag,
  .work-card:focus-visible .work-card__tag {
    /* --tag-text is the accent darkened until it clears 4.5:1 against
       this exact background (computed in the frontmatter) — the raw
       accent alone measured as low as 2.1:1 here for some projects. */
    color: var(--tag-text, var(--card-accent, var(--color-text)));
    background: color-mix(in srgb, var(--card-accent, var(--color-muted)) 14%, var(--color-bg));
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card__tag {
      transition: none;
    }
  }

  .work-card__description {
    display: block;
    margin-top: var(--space-2);
    font-size: 0.8125rem;
    color: var(--color-muted);
  }

  @media (max-width: 480px) {
    .work-card__top {
      flex-wrap: wrap;
    }

    .work-card__title-text {
      overflow: visible;
      white-space: normal;
    }
  }
</style>
