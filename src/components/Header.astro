---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import avatar from '../assets/images/avatar.png';
import avatarHover from '../assets/images/avatar-hover.png';
import { squigglePath } from '../lib/squiggle';

interface Props {
  hideOnScroll?: boolean;
}

const { hideOnScroll = false } = Astro.props;

// Highlights the section you're actually in, not just /work itself —
// /work/neoos should still mark "Work" current.
const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class:list={['header', { 'header--hide-on-scroll': hideOnScroll }]} data-header>
  <!-- The hand-drawn displacement used by the nav underline below, and
       by the work-card and case-study TOC underlines elsewhere — defined
       here since Header renders on every page, so this is the one place
       guaranteed to exist before anything references it. -->
  <svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <defs>
      <filter id="sketch-wobble-small" x="-10" y="-14" width="44" height="38" filterUnits="userSpaceOnUse">
        <feTurbulence type="fractalNoise" baseFrequency="0.12" numOctaves="2" seed="7" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
      </filter>
      <!-- A looser, lower-frequency wobble sized as a percentage of
           whatever it's applied to (no fixed userSpace region needed —
           the element it's used on, the work-card cursor badge, is big
           enough that a percentage region doesn't clip it), so the
           circle's fill reads as a hand-inked blot instead of a
           perfect CSS circle. Fewer, broader undulations than
           sketch-wobble-small on purpose — tiny jittery noise on a
           small solid shape reads as a rendering glitch, not a sketch. -->
      <filter id="sketch-wobble-badge" x="-20%" y="-20%" width="140%" height="140%">
        <feTurbulence type="fractalNoise" baseFrequency="0.025" numOctaves="2" seed="3" result="noise" />
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="3" xChannelSelector="R" yChannelSelector="G" />
      </filter>
    </defs>
  </svg>

  <div class="wrapper header__row">
    <a href="/" class="header__brand">
      <span class="header__avatar-link">
        <Image
          src={avatar}
          alt=""
          width={54}
          height={54}
          densities={[1, 2]}
          class="header__avatar header__avatar--base"
        />
        <Image
          src={avatarHover}
          alt=""
          aria-hidden="true"
          width={54}
          height={54}
          densities={[1, 2]}
          class="header__avatar header__avatar--hover"
        />
      </span>
      <span class="header__name">Aditya Acharya</span>
    </a>
    <nav class="header__nav" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} class:list={{ 'is-active': isCurrent(item.href) }}>
          {item.label}
          <svg class="header__nav-underline" viewBox="0 0 24 10" preserveAspectRatio="none" aria-hidden="true"><path d={squigglePath(`${item.href}-underline`)} /></svg>
        </a>
      ))}
      <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="header__resume">
        Resume
      </a>
    </nav>
  </div>
</header>

<script>
  // astro:page-load fires on the initial load and again after every
  // view-transition navigation, so this setup re-runs for each new page
  // without needing the script tag itself re-executed (data-astro-rerun
  // forces Astro to inline the script unprocessed, which breaks the
  // TypeScript syntax used here — this event is the supported way to
  // get the same "run again per page" behavior on a normally-bundled
  // script).
  document.addEventListener('astro:page-load', () => {
    const header = document.querySelector<HTMLElement>('[data-header].header--hide-on-scroll');

    // `window` survives a view-transition navigation (unlike a real
    // reload), so a listener added here on every page would keep
    // stacking up, each one still pointlessly updating a detached header
    // from a previous page. Drop the last one before adding a new one.
    const win = window as unknown as { __headerScrollHandler?: () => void };
    if (win.__headerScrollHandler) {
      window.removeEventListener('scroll', win.__headerScrollHandler);
    }

    if (header) {
      let lastY = window.scrollY;
      let ticking = false;
      const revealThreshold = 80; // don't hide until scrolled a bit past the top

      const updateHeader = () => {
        ticking = false;
        const y = window.scrollY;
        const scrollingDown = y > lastY;

        if (y > revealThreshold && scrollingDown) {
          header.classList.add('is-hidden');
        } else {
          header.classList.remove('is-hidden');
        }

        lastY = y;
      };

      const onScroll = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(updateHeader);
        }
      };

      window.addEventListener('scroll', onScroll, { passive: true });
      win.__headerScrollHandler = onScroll;
    }
  });
</script>

<style>
  .header {
    padding-top: var(--space-5);
  }

  .header--hide-on-scroll {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    padding-bottom: var(--space-3);
    transition: transform var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .header--hide-on-scroll.is-hidden {
    transform: translateY(-100%);
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .header--hide-on-scroll {
      transition: none;
    }
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    text-decoration: none;
    color: var(--color-text);
  }

  .header__avatar-link {
    position: relative;
    display: block;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .header__name {
    font-size: var(--text-nav);
    font-weight: 500;
  }

  .header__avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .header__avatar--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .header__brand:hover .header__avatar--base,
  .header__brand:focus-visible .header__avatar--base {
    opacity: 0;
  }

  .header__brand:hover .header__avatar--hover,
  .header__brand:focus-visible .header__avatar--hover {
    opacity: 1;
    transform: scale(1.05) rotate(-3deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__avatar {
      transition: none;
    }

    .header__brand:hover .header__avatar--hover,
    .header__brand:focus-visible .header__avatar--hover {
      transform: none;
    }
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: var(--text-nav);
  }

  .header__nav a {
    position: relative;
    display: inline-block;
    text-decoration: none;
    padding-bottom: 6px;
    color: var(--color-muted);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  /* The current page, not just hover: muted at rest like everything
     else, full text color and a touch heavier once it's where you
     actually are — the one piece of nav that previously gave no sign
     of which section you were in. */
  .header__nav a.is-active {
    color: var(--color-text);
    font-weight: 600;
  }

  /* Same hand-drawn squiggle as the work-card and TOC underlines,
     in place of the old dead-straight ::after line — this was the
     last plain geometric underline left on the site. */
  .header__nav-underline {
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 7px;
    overflow: visible;
    pointer-events: none;
  }

  .header__nav-underline path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    filter: url(#sketch-wobble-small);
    opacity: 0;
    transform: scaleX(0.9);
    transform-origin: left center;
    transition: opacity var(--duration-fast) var(--ease-standard),
      transform 260ms var(--ease-entrance);
  }

  .header__nav a:hover .header__nav-underline path,
  .header__nav a:focus-visible .header__nav-underline path,
  .header__nav a.is-active .header__nav-underline path {
    opacity: 0.85;
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__nav-underline path {
      transition: none;
    }
  }

  .header__nav a.header__resume {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .header__name {
      display: none;
    }

    .header__nav {
      gap: var(--space-4);
      font-size: 0.875rem;
    }
  }
</style>
