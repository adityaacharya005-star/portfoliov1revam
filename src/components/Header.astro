---
import { Image } from 'astro:assets';
import { site } from '../data/site';
import avatar from '../assets/images/avatar.png';
import avatarHover from '../assets/images/avatar-hover.png';
---

<header class="header">
  <div class="wrapper header__row">
    <a href="/" class="header__brand">
      <span class="header__avatar-link">
        <Image
          src={avatar}
          alt=""
          width={54}
          height={54}
          class="header__avatar header__avatar--base"
        />
        <Image
          src={avatarHover}
          alt=""
          aria-hidden="true"
          width={54}
          height={54}
          class="header__avatar header__avatar--hover"
        />
      </span>
      <span class="header__name">Aditya Acharya</span>
    </a>
    <nav class="header__nav" aria-label="Primary">
      {site.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
      <a href={site.resumeUrl} target="_blank" rel="noopener noreferrer" class="header__resume">
        Resume
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    padding-top: var(--space-5);
  }

  .header__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    text-decoration: none;
    color: var(--color-text);
  }

  .header__avatar-link {
    position: relative;
    display: block;
    width: 54px;
    height: 54px;
    flex-shrink: 0;
    border-radius: 50%;
  }

  .header__name {
    font-size: var(--text-nav);
    font-weight: 500;
  }

  .header__avatar {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    object-fit: cover;
    transition: transform var(--duration-fast) var(--ease-standard),
      opacity var(--duration-fast) var(--ease-standard);
  }

  .header__avatar--hover {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  .header__avatar-link:hover .header__avatar--base,
  .header__avatar-link:focus-visible .header__avatar--base {
    opacity: 0;
  }

  .header__avatar-link:hover .header__avatar--hover,
  .header__avatar-link:focus-visible .header__avatar--hover {
    opacity: 1;
    transform: scale(1.05) rotate(-3deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .header__avatar {
      transition: none;
    }

    .header__avatar-link:hover .header__avatar--hover,
    .header__avatar-link:focus-visible .header__avatar--hover {
      transform: none;
    }
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    font-size: var(--text-nav);
  }

  .header__nav a {
    text-decoration: none;
  }

  .header__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .header__resume {
    color: var(--color-accent);
  }

  @media (max-width: 480px) {
    .header__name {
      display: none;
    }

    .header__nav {
      gap: var(--space-4);
      font-size: 0.875rem;
    }
  }
</style>
