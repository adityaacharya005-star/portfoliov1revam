---
import type { CollectionEntry } from 'astro:content';
import WorkCard from './WorkCard.astro';

interface Props {
  entries: CollectionEntry<'work'>[];
}

const { entries } = Astro.props;
---

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <defs>
    <!-- Same loose-ink displacement as the case study pages' TOC dash,
         with a fixed userSpace region (a percentage one is too small to
         contain the displacement on an element this thin and clips it
         away to nothing). Defined once here since WorkCard's filter
         reference just needs the id to exist somewhere in the page. -->
    <filter id="sketch-wobble-small" x="-10" y="-14" width="44" height="38" filterUnits="userSpaceOnUse">
      <feTurbulence type="fractalNoise" baseFrequency="0.12" numOctaves="2" seed="7" result="noise" />
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="1.4" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </defs>
</svg>

<div class="work-grid">
  {entries.map((entry) => (
    <WorkCard
      href={`/work/${entry.slug}`}
      title={entry.data.title}
      description={entry.data.description}
      cover={entry.data.cover}
      coverAlt={entry.data.coverAlt}
      tags={entry.data.services}
      thumbVideoMp4={entry.data.thumbVideoMp4}
      thumbVideoWebm={entry.data.thumbVideoWebm}
      accentColor={entry.data.accentColor}
    />
  ))}
</div>

<style>
  .work-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--grid-gap-column);
    row-gap: var(--grid-gap-row);
  }

  @media (max-width: 480px) {
    .work-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
